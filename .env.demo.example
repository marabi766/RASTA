# ---------------------------------------------------------------------------
# Rasta investor preview — browser configuration
#
# Every value here is public by construction: three are the identity provider's
# own coordinates, one is the API Gateway origin, and the last selects which
# data source the build talks to. Next inlines `NEXT_PUBLIC_*` into the browser
# bundle, so nothing that is not already public may ever be added to this file.
#
# There is no secret here, and there must never be one. A password, a client
# secret or a token in a `NEXT_PUBLIC_` variable is published to every visitor.
# ---------------------------------------------------------------------------

# --- Which data source? ----------------------------------------------------
#
#   fixture  — the portable presentation. No backend, no network, no sign-in.
#              Data is invented, deterministic, and labelled as such on every
#              page by a banner that cannot be dismissed.
#
#   live     — the real thing. Reads through the API Gateway with a real
#              Keycloak session. This is the default: any value other than the
#              exact string `fixture` means live.
#
# Nothing switches this at runtime. A failing live request stays a visible
# failure and never falls back to fixtures — an audience looking at plausible
# data has no way to know the backend is down, and neither would the presenter.
NEXT_PUBLIC_DEMO_DATA_MODE=fixture

# --- Live mode only --------------------------------------------------------
#
# Ignored in fixture mode, which contacts neither. Kept here so one file works
# for both, and so switching modes is a one-line edit rather than a hunt.
#
# If the gateway runs on a different port on your machine — 3010 is common,
# because an unrelated container often holds 3000 — change this *and*
# `PORT_API_GATEWAY` in the root `.env` together. Changing only one produces a
# portal that reports "ارتباط برقرار نشد" on every live screen.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=rasta
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=rasta-web
