# =============================================================================
# Rasta — local development environment
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# Every value here is a throwaway development credential; production secrets
# come from the platform secret store (see docs/security/secrets-management.md).
#
# Boolean flags. Every `*_ENABLED`, `*_STRICT` and `*_FAIL_OPEN` variable below
# is parsed by one shared parser (`booleanEnv` in `@rasta/config`), so the
# accepted spellings are the same everywhere — trimmed and case-insensitive:
#
#   true  -> true, 1, yes, on
#   false -> false, 0, no, off, and an empty value
#
# An empty value means false, not "unset": `FLAG=` is something an operator
# wrote on purpose and it will not fall through to the default. Anything else
# — including a typo like `ture` — fails validation and stops the service at
# boot rather than being guessed at (D-020).
# =============================================================================

NODE_ENV=development
# Demo seeds (`pnpm db:seed`) overwrite fixed identifiers — ORG-DEH-0001,
# USR-SEED-* — with sample data, so each one refuses to run unless NODE_ENV is
# development or test AND this is exactly `true`. Deliberately empty here: type
# it for the run (`RASTA_ALLOW_DEMO_SEED=true pnpm db:seed`) rather than leave it
# in a file that may one day sit beside production credentials.
# A third check is the database's, not the shell's: each seed also refuses a
# database that does not carry `rasta.disposable_database=true`, which only
# the development/CI bootstrap sets (infrastructure/docker/postgres). A volume
# created before that marker existed needs `pnpm db:mark-disposable` once.
RASTA_ALLOW_DEMO_SEED=
LOG_LEVEL=debug
SERVICE_ENV=local

# ---------- PostgreSQL (one cluster in dev, one logical DB per service) ------
# Rasta maps its container to 5433, not 5432. A local PostgreSQL install
# owning 5432 is common on developer machines, and the clash is silent:
# Docker still starts, but host connections reach the wrong server.
# The host is the IPv4 literal on purpose, not `localhost`: Docker or a
# temporary TCP forwarder may publish the port on IPv4 only, while `localhost`
# can resolve to ::1 first. Each new pooled connection then waits for the IPv6
# attempt to fail, and concurrent transactions time out with Prisma P2028. A
# local developer default only, not a production networking rule;
# `pnpm check:local-postgres-config` enforces it.
# Host address docker-compose publishes every port on (L7-38). Loopback by
# default: the dev stack runs with development credentials or none, so a port
# on 0.0.0.0 is open to anyone on the same network. Set 0.0.0.0 only on a
# machine whose network you control, and only for as long as you need it.
COMPOSE_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_SUPERUSER=rasta
POSTGRES_SUPERUSER_PASSWORD=rasta_dev_password
# One password per database role (L7-33). The init script creates each role
# with POSTGRES_PASSWORD_<ROLE>, and each DATABASE_URL_* below uses its own
# role's — so one service's connection string opens no other service's
# database, and the audit runtime role cannot log in as the migrator that owns
# its tables. Dev values only: every real environment sets its own. URL-safe
# characters only ([A-Za-z0-9_.~-], 16+), since they sit unescaped in URLs.
# Every value must differ from every other and from the superuser's: the
# bootstrap, the rotation command and `pnpm infra:up` all refuse duplicates.
# An existing local volume keeps whatever passwords it was created with (the
# init script runs only on an empty volume). To apply these to it, keeping the
# data: `pnpm infra:up`, then `pnpm db:rotate-role-passwords`. Do not use
# `pnpm infra:reset` for this — it deletes every database.
POSTGRES_PASSWORD_IDENTITY=rasta_identity_dev_password
POSTGRES_PASSWORD_ORGANIZATION=rasta_organization_dev_password
POSTGRES_PASSWORD_ASSET=rasta_asset_dev_password
POSTGRES_PASSWORD_FLEET=rasta_fleet_dev_password
POSTGRES_PASSWORD_MAINTENANCE=rasta_maintenance_dev_password
POSTGRES_PASSWORD_MARKETPLACE=rasta_marketplace_dev_password
POSTGRES_PASSWORD_PROCUREMENT=rasta_procurement_dev_password
POSTGRES_PASSWORD_SUPPLIER=rasta_supplier_dev_password
POSTGRES_PASSWORD_INVENTORY=rasta_inventory_dev_password
POSTGRES_PASSWORD_CONSTRUCTION=rasta_construction_dev_password
POSTGRES_PASSWORD_CONTRACT=rasta_contract_dev_password
POSTGRES_PASSWORD_ECONOMIC=rasta_economic_dev_password
POSTGRES_PASSWORD_NOTIFICATION=rasta_notification_dev_password
POSTGRES_PASSWORD_DOCUMENT=rasta_document_dev_password
POSTGRES_PASSWORD_AUDIT=rasta_audit_dev_password
POSTGRES_PASSWORD_ANALYTICS=rasta_analytics_dev_password
POSTGRES_PASSWORD_AUDIT_MIGRATOR=rasta_audit_migrator_dev_password

DATABASE_URL_IDENTITY=postgresql://rasta_identity:rasta_identity_dev_password@127.0.0.1:5433/rasta_identity?schema=public
DATABASE_URL_ORGANIZATION=postgresql://rasta_organization:rasta_organization_dev_password@127.0.0.1:5433/rasta_organization?schema=public
DATABASE_URL_ASSET=postgresql://rasta_asset:rasta_asset_dev_password@127.0.0.1:5433/rasta_asset?schema=public
DATABASE_URL_FLEET=postgresql://rasta_fleet:rasta_fleet_dev_password@127.0.0.1:5433/rasta_fleet?schema=public
DATABASE_URL_MAINTENANCE=postgresql://rasta_maintenance:rasta_maintenance_dev_password@127.0.0.1:5433/rasta_maintenance?schema=public
DATABASE_URL_MARKETPLACE=postgresql://rasta_marketplace:rasta_marketplace_dev_password@127.0.0.1:5433/rasta_marketplace?schema=public
DATABASE_URL_PROCUREMENT=postgresql://rasta_procurement:rasta_procurement_dev_password@127.0.0.1:5433/rasta_procurement?schema=public
DATABASE_URL_SUPPLIER=postgresql://rasta_supplier:rasta_supplier_dev_password@127.0.0.1:5433/rasta_supplier?schema=public
DATABASE_URL_INVENTORY=postgresql://rasta_inventory:rasta_inventory_dev_password@127.0.0.1:5433/rasta_inventory?schema=public
DATABASE_URL_CONSTRUCTION=postgresql://rasta_construction:rasta_construction_dev_password@127.0.0.1:5433/rasta_construction?schema=public
DATABASE_URL_CONTRACT=postgresql://rasta_contract:rasta_contract_dev_password@127.0.0.1:5433/rasta_contract?schema=public
DATABASE_URL_ECONOMIC=postgresql://rasta_economic:rasta_economic_dev_password@127.0.0.1:5433/rasta_economic?schema=public
DATABASE_URL_NOTIFICATION=postgresql://rasta_notification:rasta_notification_dev_password@127.0.0.1:5433/rasta_notification?schema=public
DATABASE_URL_DOCUMENT=postgresql://rasta_document:rasta_document_dev_password@127.0.0.1:5433/rasta_document?schema=public
# audit-service runs as rasta_audit against schema `audit`, which it does NOT own.
# ADR-053 makes audit_event append-only, and a privilege the runtime role can
# grant back to itself is not a barrier -- so the tables are owned by
# rasta_audit_migrator and this connection gets only SELECT and INSERT.
DATABASE_URL_AUDIT=postgresql://rasta_audit:rasta_audit_dev_password@127.0.0.1:5433/rasta_audit?schema=audit
# Used by `pnpm --filter @rasta/audit-service db:migrate` only. scripts/prisma.mjs
# prefers DATABASE_URL_<SVC>_MIGRATOR when a service declares one; the service
# process itself never reads this and must never be given it.
DATABASE_URL_AUDIT_MIGRATOR=postgresql://rasta_audit_migrator:rasta_audit_migrator_dev_password@127.0.0.1:5433/rasta_audit?schema=audit
DATABASE_URL_ANALYTICS=postgresql://rasta_analytics:rasta_analytics_dev_password@127.0.0.1:5433/rasta_analytics?schema=public

# ---------- Redis -----------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------- Kafka -----------------------------------------------------------
# The host port the broker is published on. 9092 works almost everywhere, but
# Windows reserves dynamic port ranges that can swallow it — check with
# `netsh interface ipv4 show excludedportrange protocol=tcp` if Docker refuses
# to publish it, and pick a port outside every listed range. Same class of
# clash as POSTGRES_PORT above, and the advertised listener follows this value.
KAFKA_HOST_PORT=9092
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=rasta
KAFKA_SCHEMA_STRICT=true

# ---------- Outbox durable claim (ADR-050) ----------------------------------
# How long a relay owns the rows it claimed. The floor is 20s: the renewal
# interval is lease/4, so a shorter lease would not fit three renewal attempts
# before expiry and would tolerate zero lost renewals.
OUTBOX_CLAIM_LEASE_SECONDS=60
# Capped exponential retry: min(2^min(attempts,10) x base, max), all computed
# with the database clock so replica skew cannot move it.
OUTBOX_CLAIM_BACKOFF_SECONDS=5
OUTBOX_CLAIM_BACKOFF_MAX_SECONDS=3600
# Shutdown keeps a lease alive this long for a publish whose result is still
# unknown, then abandons it without releasing it. Bounded so a pod cannot hang
# in Terminating behind a Kafka request that cannot be cancelled.
OUTBOX_SHUTDOWN_GRACE_SECONDS=30

# ---------- Refusal audit outbox (ADR-053 § 4, identity-service) ------------
# The longest a refused request (403) waits for its security_event_outbox row
# before the refusal is returned without it. Capture is best-effort: success,
# timeout and failure all return the identical 403. Range 10..5000.
SECURITY_EVENT_CAPTURE_TIMEOUT_MS=250
# The refusal relay's poll interval and batch. Lease, backoff and shutdown
# grace are the OUTBOX_* values above — one set of ADR-050 claim semantics.
SECURITY_EVENT_FLUSH_INTERVAL_MS=1000
SECURITY_EVENT_FLUSH_BATCH_SIZE=100
# Matching refusals (same tenant, actor, action, resource and error code) are
# counted into one row per UTC window of this many seconds and published once
# the window closes on the database clock (ADR-053 § 4, AUD-004 Phase C2). 60 is
# ADR-053's "500 probes in one minute". Range 1..3600 — the window is also the
# least time before a refusal reaches the audit trail.
SECURITY_EVENT_AGGREGATION_WINDOW_SECONDS=60

# ---------- Role-grant ladder (identity-service, docs/24 Q-60) --------------
# Which roles each acting role may hand out. The route guards answer *may this
# kind of user change roles at all*; these answer *which roles*, which is the
# question that was missing — an ORGANIZATION_ADMIN could grant SYSTEM_ADMIN.
#
# Comma-separated, validated at startup: an unknown role fails the deployment
# rather than silently granting nothing. Empty means this role grants nothing.
# SYSTEM_ADMIN is refused in all three and is not grantable through the API at
# all — no operator console exists yet to justify handing it out (ADR-058 § 2).
#
# The defaults are the scope column of docs/09 § RBAC read narrowly. The two
# genuinely open points are Q-60: whether an administrator may promote a peer
# to their own role (default yes, for ORGANIZATION_ADMIN) and who appoints the
# supplier-organization and province roles (default: only the platform
# operator). Widening any of these widens real authority.
ROLE_GRANTS_BY_SYSTEM_ADMIN=UNION_ADMIN,ORGANIZATION_ADMIN,FLEET_MANAGER,DRIVER,OPERATOR,PROCUREMENT_USER,SUPPLIER,WORKSHOP,CONTRACTOR,AUDITOR
ROLE_GRANTS_BY_UNION_ADMIN=UNION_ADMIN,ORGANIZATION_ADMIN,FLEET_MANAGER,DRIVER,OPERATOR,PROCUREMENT_USER
ROLE_GRANTS_BY_ORGANIZATION_ADMIN=ORGANIZATION_ADMIN,FLEET_MANAGER,DRIVER,OPERATOR,PROCUREMENT_USER

# Which roles may provision a user into an organization OTHER than the one they
# are acting for (docs/24 Q-61). Everyone else must name their own active
# organization, on all three paths that create a membership: creating a user,
# adding a membership, and approving a registration.
#
# ORGANIZATION_ADMIN is absent because docs/09 scopes it to its own
# organization. UNION_ADMIN is absent as the narrow reading of a question the
# product document does not answer — "Platform-scoped" is not the same claim as
# "may create accounts in any organization on the platform". Adding it here
# restores that reach with no release, and also lets a union administrator
# approve a registration for another organization, which this default forbids.
USER_PROVISIONING_CROSS_ORG_ROLES=SYSTEM_ADMIN

# ADR-060 § 5 — the membership expiry sweep. An expired membership grants
# nothing whether or not this runs; the sweep is what removes it from the
# user's Keycloak attributes (and so their next token) and records
# MEMBERSHIP_EXPIRED. The interval adds to ADR-060 § 7's 905 s: the last token
# naming an expired organization is at most interval + 905 s after validUntil.
MEMBERSHIP_EXPIRY_SCAN_ENABLED=true
MEMBERSHIP_EXPIRY_SCAN_INTERVAL_SECONDS=60
MEMBERSHIP_EXPIRY_SCAN_BATCH_SIZE=200

# ---------- Keycloak / OIDC -------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=rasta
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
# Confidential client used by backend services for the admin API and token exchange.
KEYCLOAK_BACKEND_CLIENT_ID=rasta-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=backend_dev_secret_change_me
# When false, identity-service records provisioning locally and skips the
# Keycloak call — for unit and API tests without an identity provider. Never
# false in a deployed environment.
KEYCLOAK_SYNC_ENABLED=true
# Public client used by the web/admin frontends (PKCE, no secret).
KEYCLOAK_WEB_CLIENT_ID=rasta-web
OIDC_ISSUER_URL=http://localhost:8080/realms/rasta
OIDC_JWKS_URI=http://localhost:8080/realms/rasta/protocol/openid-connect/certs
OIDC_AUDIENCE=rasta-api

# ---------- The portal's own server (apps/web, ADR-059) ---------------------
# The portal runs the OIDC flow on its server, not in the browser: no access
# token and no refresh token ever reaches JavaScript. These values belong to
# that server and NONE of them may ever be prefixed NEXT_PUBLIC_ — Next.js
# decides what ships to the browser by exactly that prefix.
#
# The only origin the portal's server code may call. Every platform control —
# JWT verification, tenant resolution, rate limiting, correlation, the circuit
# breaker — lives at the gateway, and a call to a service port would run with
# none of them. `gateway.spec.ts` refuses anything else.
API_GATEWAY_URL=http://localhost:3000
# The public client the realm already ships. PKCE, no secret.
OIDC_CLIENT_ID=rasta-web
# Where Keycloak sends the browser back, as the browser sees it. Must match a
# redirect URI registered on the client, exactly.
WEB_PUBLIC_ORIGIN=http://localhost:3200
# Seals the session cookie with AES-256-GCM. THIRTY-TWO CHARACTERS OR MORE, and
# the portal REFUSES TO START without it: an unencrypted session cookie hands a
# working refresh token to anybody who can read a cookie jar. Generate a real
# one per environment, for example: openssl rand -base64 48
WEB_SESSION_SECRET=dev_only_session_secret_change_me_0123456789
# A ceiling on how long a sealed session may live, whatever the token lifetimes
# inside it. A sealed session cannot be revoked centrally (ADR-059), so this is
# what bounds a stolen cookie.
WEB_SESSION_MAX_AGE_SECONDS=43200
# Local development speaks plain HTTP, where a `Secure` cookie is never sent at
# all — the portal would appear to log nobody in. TRUE EVERYWHERE ELSE.
WEB_COOKIE_SECURE=false
# Coordinates session refreshes across replicas: the realm refuses a refresh
# token's reuse, and two replicas must not both spend one. REQUIRED when
# NODE_ENV=production — the portal exits at start without it. Optional in
# development and test, with a warning.
WEB_REDIS_URL=redis://localhost:6379

# ---------- Object storage (S3-compatible, MinIO in dev) --------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rasta_minio_admin
S3_SECRET_KEY=rasta_minio_dev_password
S3_BUCKET_DOCUMENTS=rasta-documents
S3_FORCE_PATH_STYLE=true

# ---------- document-service (ADR-014) --------------------------------------
# How long a signed URL lives. It is a bearer credential for one object —
# anybody holding it needs no token and no role — so the value is bounded
# (30..3600) as well as defaulted. ADR-014 fixes the canonical default at five
# minutes.
DOCUMENT_SIGNED_URL_TTL_SECONDS=300
# Longer than the signed PUT URL it accompanies, so a client that uploaded at
# the last second can still finalize (60..86400).
DOCUMENT_UPLOAD_INTENT_TTL_SECONDS=900
# The ceiling this service will register under any document class, in bytes.
DOCUMENT_MAX_BYTES=26214400
#
# There is deliberately NO setting here that permits downloading a document
# nothing has scanned. ADR-014 keeps a file unavailable until malware scanning
# completes, and nothing below reintroduces the flag that used to allow it —
# every scanning setting here tunes *how* scanning happens, and none of them
# can make an unscanned document downloadable.

# ---------- Malware scanning (ADR-049, closes Q-18) -------------------------
# `clamav` is the platform answer. `disabled` binds the no-op stub, which
# inspects nothing and records NOT_SCANNED — a development convenience for
# working on upload and metadata without a scanner running, and refused
# outright when NODE_ENV is production. It is not a bypass: NOT_SCANNED is
# never downloadable, so a deployment set this way hands back nothing.
DOCUMENT_SCANNER_DRIVER=clamav
#
# Where clamd is. **Production must use the Unix socket.** The clamd protocol
# authenticates nobody — anything that can reach a TCP port can submit a
# stream and enumerate the signature database — so a TCP listener's only
# protection would be "nothing else is on this network", which AGENTS.md S-08
# forbids relying on. document-service refuses DOCUMENT_CLAMAV_HOST when
# NODE_ENV is production and exits at startup.
#
# Local development uses TCP because a Linux container's socket cannot be
# reached by a Node process on a Windows host. `docker compose` publishes it
# on 127.0.0.1 only. CI on Linux uses the socket, so the production transport
# is the one proven there.
# DOCUMENT_CLAMAV_SOCKET_PATH=/run/clamav/clamd.sock
DOCUMENT_CLAMAV_HOST=127.0.0.1
DOCUMENT_CLAMAV_PORT=3310
#
# One deadline for the whole exchange — connect, stream and reply (1s..10m).
DOCUMENT_SCAN_TIMEOUT_MS=60000
# Bytes per INSTREAM frame: how much of an object is ever resident at once.
DOCUMENT_SCAN_CHUNK_BYTES=65536
# The largest object this deployment submits for scanning. Below the
# StreamMaxLength in clamd.conf, so the adapter's ceiling is the one that
# fires and the refusal names a policy rather than a protocol error. An object
# above it is recorded FAILED and stays undownloadable — never CLEAN.
DOCUMENT_SCAN_MAX_BYTES=33554432
# How old the signature database may be and still support a CLEAN verdict.
# freshclam updates several times a day, so older than this means updating has
# been failing for a while. Past it the adapter refuses to scan at all and
# records STALE_SIGNATURES: an absence of matches from an old database is not
# evidence of anything. A *match* from one still stands.
DOCUMENT_SCAN_SIGNATURE_MAX_AGE_HOURS=48
DOCUMENT_SCAN_VERSION_CACHE_SECONDS=60
#
# The scan worker. Off means documents stay PENDING and undownloadable — which
# is fail-closed, not a bypass.
DOCUMENT_SCAN_WORKER_ENABLED=true
DOCUMENT_SCAN_POLL_INTERVAL_MS=2000
DOCUMENT_SCAN_BATCH_SIZE=5
# Must exceed DOCUMENT_SCAN_TIMEOUT_MS, or a scan still running loses its claim
# and a second worker starts the same document. Checked at startup.
DOCUMENT_SCAN_LEASE_SECONDS=300
# Attempts before a document is recorded FAILED for good. Finite on purpose: an
# unbounded retry keeps a permanently broken document in the queue forever,
# where its state says "waiting" rather than "this needs a person".
DOCUMENT_SCAN_MAX_ATTEMPTS=5
DOCUMENT_SCAN_RETRY_BASE_MS=5000
DOCUMENT_SCAN_RETRY_MAX_MS=300000
# The host port `docker compose` publishes clamd on, bound to 127.0.0.1.
CLAMAV_PORT=3310

# ---------- Temporal --------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=rasta-main
# marketplace-service owns its own queue (ADR-039). A shared queue would hand
# one service's worker another service's workflow tasks.
MARKETPLACE_TEMPORAL_TASK_QUEUE=rasta-order
MARKETPLACE_TEMPORAL_ENABLED=true
# Order windows (ADR-043, Q-11). Expiry records a reminder and never moves
# money: there is no automatic receipt confirmation.
MARKETPLACE_FULFILLMENT_WINDOW_DAYS=7
MARKETPLACE_RECEIPT_WINDOW_DAYS=3
MARKETPLACE_REMINDER_INTERVAL_DAYS=3
MARKETPLACE_SAGA_RECHECK_HOURS=24

# ---------- Search ----------------------------------------------------------
OPENSEARCH_NODE=http://localhost:9200

# ---------- Observability ---------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_ENABLED=true
OTEL_SERVICE_NAMESPACE=rasta

# ---------- Service ports ---------------------------------------------------
# If a port here is already in use on your machine, override it in .env rather
# than changing this file. Port 3000 in particular is claimed by almost every
# Node tool, and the failure is confusing: the service appears to start and
# then something else answers its requests.
PORT_API_GATEWAY=3000
PORT_IDENTITY=3101
PORT_ORGANIZATION=3102
PORT_ASSET=3103
PORT_FLEET=3104
PORT_MAINTENANCE=3105
PORT_MARKETPLACE=3106
PORT_PROCUREMENT=3107
PORT_SUPPLIER=3108
PORT_INVENTORY=3109
PORT_CONSTRUCTION=3110
PORT_CONTRACT=3111
PORT_ECONOMIC=3112
PORT_NOTIFICATION=3113
PORT_DOCUMENT=3114
PORT_AUDIT=3115
PORT_ANALYTICS=3116

# ---------- Internal service URLs (gateway -> service) ----------------------
IDENTITY_SERVICE_URL=http://localhost:3101
ORGANIZATION_SERVICE_URL=http://localhost:3102
ASSET_SERVICE_URL=http://localhost:3103
FLEET_SERVICE_URL=http://localhost:3104
MAINTENANCE_SERVICE_URL=http://localhost:3105
MARKETPLACE_SERVICE_URL=http://localhost:3106
PROCUREMENT_SERVICE_URL=http://localhost:3107
SUPPLIER_SERVICE_URL=http://localhost:3108
INVENTORY_SERVICE_URL=http://localhost:3109
CONSTRUCTION_SERVICE_URL=http://localhost:3110
CONTRACT_SERVICE_URL=http://localhost:3111
ECONOMIC_SERVICE_URL=http://localhost:3112
NOTIFICATION_SERVICE_URL=http://localhost:3113
DOCUMENT_SERVICE_URL=http://localhost:3114
AUDIT_SERVICE_URL=http://localhost:3115
ANALYTICS_SERVICE_URL=http://localhost:3116

# ---------- Service-to-service authentication (Zero Trust) ------------------
# Dev uses a signed internal token; production uses mTLS + workload identity.
INTERNAL_TOKEN_SECRET=internal_dev_secret_change_me_at_least_32_chars
INTERNAL_TOKEN_ISSUER=rasta-internal

# ---------- maintenance-service ---------------------------------------------
# The in-process due-date scan (ADR-027). Temporal does not own this yet, so it
# runs on a timer inside the service. In a multi-replica deployment it belongs
# on exactly one replica — which is only arrangeable now that the flag can
# actually be switched off (D-020).
MAINTENANCE_DUE_SCAN_ENABLED=true

# ---------- organization-service --------------------------------------------
# Who may set governance policy (POST /v1/organizations/:id/policies). Those
# rows decide who approves what, so who may write them is an authority
# question. The project owner answered it (docs/24 Q-64, closed by #104):
# SYSTEM_ADMIN and UNION_ADMIN, final. Held in configuration, not code.
# Comma-separated platform roles, trimmed; an unknown role or an empty list
# stops the service at start-up. SYSTEM_ADMIN is honoured regardless.
GOVERNANCE_POLICY_SETTER_ROLES=SYSTEM_ADMIN,UNION_ADMIN

# ---------- asset-service ---------------------------------------------------
# How far ahead an expiring policy or inspection is warned about. Default 30.
EXPIRY_WARNING_DAYS=30
# Who may decide an insurance claim (approve or reject) and record that it was
# settled. Comma-separated Keycloak realm roles; entries are trimmed. The
# product document names no approval authority for claims (docs/24 Q-59), so
# this is a temporary decision held in configuration, not code (AGENTS.md § 1
# principle 2). SYSTEM_ADMIN is honoured regardless, as everywhere else.
INSURANCE_CLAIM_DECISION_ROLES=ORGANIZATION_ADMIN,UNION_ADMIN
# The largest amount, in rial minor units, the roles above may approve. Empty
# means no ceiling. Set when a higher authority exists for larger claims: an
# approval above it is refused with BUSINESS_RULE_VIOLATION until that
# authority is modelled (docs/24 Q-59). Never a payment — this service records
# decisions; economic-service moves money.
INSURANCE_CLAIM_APPROVAL_CEILING_MINOR=

# ---------- Economic service ------------------------------------------------
# The organization that plays the platform operator role. Escrow is per
# organization (ADR-034), but commission revenue, reward expense and the
# simulated payment clearing account belong to this one. Configuration rather
# than a constant, so the platform stays organization-agnostic (AGENTS.md A-05).
ECONOMIC_PLATFORM_ORGANIZATION_ID=ORG-PLATFORM
# The only implementation that exists. There is NO bank connection, NO custody
# of funds and NO real money movement (ADR-024). A value other than `mock` is
# rejected at boot rather than silently falling back.
ECONOMIC_PAYMENT_PROVIDER=mock
# Fixed simulated latency, never random — a random delay makes a test flaky
# rather than realistic. Raise it in a demo environment.
ECONOMIC_MOCK_PAYMENT_LATENCY_MS=0
# Cashback is conditioned on a regulatory review that has not concluded
# (docs/24 Q-07). With this off, creating a CASHBACK rule is refused rather
# than silently ignored.
ECONOMIC_REWARD_CASHBACK_ENABLED=false
# Whether the payee's financial admin may refund escrow to the payer (docs/24 Q-62).
# The payer may never refund its own transaction, and a disputed one needs platform scope.
ECONOMIC_REFUND_BY_PAYEE_ENABLED=true
# How long a stored idempotency key is honoured (docs/06 § 6.8).
ECONOMIC_IDEMPOTENCY_TTL_HOURS=24
# The wallet/ledger reconciliation (docs/10 § 10.3). It reports deviations and
# never repairs them: a wallet that disagrees with its ledger is an incident
# for a human, not a number to quietly correct.
ECONOMIC_BALANCE_AUDIT_ENABLED=true
ECONOMIC_BALANCE_AUDIT_INTERVAL_SECONDS=3600
ECONOMIC_BALANCE_AUDIT_BATCH_SIZE=500
# Seeds one sample commission rule and one sample reward rule, both labelled
# "نمونه — نیازمند تصویب". Off by default so no environment acquires an
# unapproved rate by accident (ADR-023, docs/24 Q-08).
ECONOMIC_SEED_SAMPLE_RULES=false

# ---------- construction-service (CON-001, ADR-063) -------------------------
# Every value below is a provisional answer to an open question (docs/24) and
# can be changed without a code change. None of them names an approval
# authority or threshold: those are approval_policy rows, never environment.
#
# Q-69: who creates, edits, submits and cancels projects and needs. SYSTEM_ADMIN
# is always accepted. AUDITOR, an unknown role or an empty list stops startup.
CONSTRUCTION_PROJECT_ROLES=ORGANIZATION_ADMIN
# Q-69: extra roles that may only read projects and needs. Empty = nobody.
CONSTRUCTION_PROJECT_READER_ROLES=
# Q-69: states a project may be cancelled from; a subset of these four only.
CONSTRUCTION_CANCELLABLE_STATES=DRAFT,PENDING_APPROVAL,CHANGES_REQUESTED,APPROVED
# Q-68: empty = operationType is free text; a list restricts it to those values.
CONSTRUCTION_OPERATION_TYPES=
# docs/06 § 6.8: how long an Idempotency-Key on a create endpoint is kept.
CONSTRUCTION_IDEMPOTENCY_TTL_HOURS=24
# Q-70 (7), decided 2026-09-26: a UNION_ADMIN writes approval policies for its
# organization or one beneath it (asked of organization-service, through
# ORGANIZATION_SERVICE_URL above); every policy needs a SYSTEM_ADMIN's approval
# before it governs. Not configurable: who writes.
# PROVISIONAL, pending the owner: whether four eyes may be switched off at all.
# true (default) = the approving SYSTEM_ADMIN differs from the author and the
# submitter. false = a SYSTEM_ADMIN may approve its own policy (never a
# union's), and the service logs a WARN at startup.
CONSTRUCTION_POLICY_FOUR_EYES=true
# How long construction-service waits for that hierarchy answer (asked when a
# policy is written, submitted, approved and used); no answer in time refuses
# (504), never allows.
CONSTRUCTION_ORGANIZATION_REQUEST_TIMEOUT_MS=3000
# Q-68: submitted needs a project must have before it may request approval.
CONSTRUCTION_APPROVAL_MIN_SUBMITTED_NEEDS=1
# Q-68: whether an estimate is required before requesting approval.
CONSTRUCTION_APPROVAL_REQUIRES_ESTIMATE=true
# Q-71: true = no project starts until the contract boundary (CON-003) exists.
CONSTRUCTION_START_REQUIRES_CONTRACT=false
# Q-72: whether a submitted progress report may report less than the last one.
CONSTRUCTION_PROGRESS_ALLOW_DECREASE=false

# ---------- audit-service ---------------------------------------------------
# The widest from..to one audit query may cover, in days (ADR-053 § 10).
# audit_event is partitioned monthly across years, so an unbounded range scans
# every partition -- an accidental denial of service rather than a slow query.
# The ceiling is what makes partition pruning effective. A wider request is
# refused with 400 VALIDATION_FAILED naming this number, never truncated
# silently (docs/06 § 6.5). Accepted range: 1..366.
AUDIT_MAX_QUERY_WINDOW_DAYS=90

# The most chain records one verification may walk (AUD-003, ADR-053 § 6).
# The window ceiling above bounds the time a verification covers; it does not
# bound the work, because a busy tenant writes more records in a day than a
# quiet one writes in a quarter. Verification recomputes a SHA-256 per record,
# so an unbounded walk is the most expensive operation this service offers.
# What is counted is the contiguous chain interval the walk will read -- not
# the records whose occurred_at lands inside the window -- and the request is
# refused with 400 VALIDATION_FAILED from row counts, before any record is
# read. Accepted range: 1000..5000000.
AUDIT_MAX_VERIFICATION_RECORDS=100000

# Audit producers whose silence should alert (RastaAuditProducerSilent,
# ADR-053 § 13). Comma-separated; entries are trimmed and deduplicated. Allowed:
# identity-service, organization-service, asset-service, fleet-service,
# maintenance-service, marketplace-service, economic-service, document-service,
# supplier-service. An unknown name or an empty element (a,,b or a trailing
# comma) refuses to boot. Empty by default: no document states which services
# must emit audit events continuously or how long a quiet period is legitimate
# (docs/24 Q-54), so without an explicit traffic expectation nothing is watched.
# Exported as rasta_audit_expected_active_producer{source_service} 1; the local
# rule fires after 6h30m with no row from a listed producer.
AUDIT_EXPECTED_ACTIVE_PRODUCERS=

# ---------- API Gateway -----------------------------------------------------
GATEWAY_CORS_ORIGINS=http://localhost:3200,http://localhost:3201
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
GATEWAY_RATE_LIMIT_MAX=300
# What happens to every request when Redis is unreachable. Rate limiting
# protects against overload; it is not the authorization boundary, so the
# default lets traffic through and alerts rather than converting a cache
# outage into a full one. Set it to false where abuse risk outweighs
# availability — and note that it now actually takes effect (D-020).
GATEWAY_RATE_LIMIT_FAIL_OPEN=true
# The hops allowed to state the client address in X-Forwarded-For (L1-03):
# the ingress or load balancer in front of the gateway. Comma-separated IP
# addresses, CIDR ranges, or loopback / linklocal / uniquelocal. Empty trusts
# nobody — safe, but behind an ingress every anonymous caller then shares the
# ingress's rate-limit bucket. "Trust all", hop counts and /0 ranges are refused
# at start-up: each believes a header the client wrote. Name proxy peers only,
# never a range that also holds clients — any address in the list may name the
# client, so a client inside a trusted range picks its own rate-limit bucket.
GATEWAY_TRUSTED_PROXIES=

# ---------- Frontend --------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=rasta
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=rasta-web

# ---------- End-to-end tests (tests/e2e) ------------------------------------
# Only needed to run `pnpm test:e2e`, and every one of them has a default that
# matches the rest of this file — so a stack started with `pnpm infra:up` plus
# api-gateway and economic-service needs none of them set. Override when a port
# differs on your machine, as KAFKA_HOST_PORT and PORT_API_GATEWAY sometimes do.
#
# There is no password here. The suite reads the throwaway development one from
# infrastructure/docker/keycloak/rasta-realm.json, which already owns it —
# a second copy would be a second thing to keep in step and a second thing for
# a secret scanner to find. E2E_USER_PASSWORD overrides it for an environment
# whose realm was provisioned elsewhere.
E2E_GATEWAY_URL=http://localhost:3000
E2E_ECONOMIC_URL=http://localhost:3112

# ---------- notification-service (ADR-054, NTF-001) -------------------------
# Every value below has a default in `services/notification-service/src/config/env.ts`
# and a bounded range, so a misconfiguration cannot disable the control it
# belongs to. Recipients are resolved through identity-service's authenticated
# API (IDENTITY_SERVICE_URL above, never the gateway); no address ever enters
# this service's database or its logs.
#
# There is deliberately NO email provider, host, credential or sender identity
# here. None has been chosen (docs/24 Q-37), and a key with a default would
# settle that silently. No email has ever been sent from this platform.
NOTIFICATION_IDENTITY_REQUEST_TIMEOUT_MS=5000
# Hard ceiling on recipients per intent; more is truncated, counted and alerted.
NOTIFICATION_MAX_RECIPIENTS_PER_INTENT=500
NOTIFICATION_RECIPIENT_CACHE_TTL_SECONDS=60
# Semantic dedupe windows are kept this long (ADR-054 § 3). A replay of an event
# older than this notifies again — a declared bound, not a silent one.
NOTIFICATION_DEDUPE_RETENTION_DAYS=45
NOTIFICATION_IN_APP_TTL_DAYS=60
# The claim-based resolution worker (ADR-050 shape). Safe on every replica.
NOTIFICATION_RESOLUTION_POLL_INTERVAL_MS=1000
NOTIFICATION_RESOLUTION_BATCH_SIZE=20
NOTIFICATION_RESOLUTION_LEASE_SECONDS=60
NOTIFICATION_RESOLUTION_BACKOFF_MAX_SECONDS=600

# --- notification: the mail channel (ADR-054 § 6, docs/24 Q-37) --------------
# The port exists; the provider decision does not. `smtp` is the only accepted
# adapter and any other value REFUSES BOOT — the same shape as
# ECONOMIC_PAYMENT_PROVIDER, and for the same reason: an environment that
# expected a real provider must never fall back to a development one quietly.
NOTIFICATION_MAIL_ADAPTER=smtp
# Mailpit. It lives behind the `tools`/`all` compose profiles, so `pnpm infra:up`
# does NOT start it: `docker compose --profile tools up -d mailpit`.
NOTIFICATION_SMTP_HOST=localhost
NOTIFICATION_SMTP_PORT=1025
NOTIFICATION_SMTP_SECURE=false
# Both or neither. A user with no password is a deployment that believes it is
# authenticating and is not.
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_SMTP_TIMEOUT_MS=10000
# NO SENDER IDENTITY HAS BEEN CHOSEN. `.invalid` is reserved by RFC 2606 and can
# never resolve, so a misconfigured deployment fails to send rather than sending
# as somebody. Choosing a real domain here is half of answering Q-37; the other
# half is the provider allowed to send for it.
NOTIFICATION_MAIL_FROM_ADDRESS=notifications@rasta.invalid
NOTIFICATION_MAIL_FROM_NAME=رستا
# The worker that sends what the dispatch transaction queued (NTF-004). Its own
# tunables rather than the resolution worker's: identity answers in
# milliseconds and a mail server may take seconds per message, so one lease
# length would be wrong for one of them — and the one sized wrongly is the one
# whose leases expire mid-send. The batch is small because a tick sends its
# messages one after another.
NOTIFICATION_MAIL_POLL_INTERVAL_MS=2000
NOTIFICATION_MAIL_BATCH_SIZE=10
NOTIFICATION_MAIL_LEASE_SECONDS=120
# Ceiling on one backoff wait. The ladder is 1s, 5s, 30s, 2m, 10m with jitter,
# then the delivery is DEAD — six attempts in all.
NOTIFICATION_MAIL_BACKOFF_MAX_SECONDS=600
