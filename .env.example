# =============================================================================
# Rasta — local development environment
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# Every value here is a throwaway development credential; production secrets
# come from the platform secret store (see docs/security/secrets-management.md).
# =============================================================================

NODE_ENV=development
LOG_LEVEL=debug
SERVICE_ENV=local

# ---------- PostgreSQL (one cluster in dev, one logical DB per service) ------
# Rasta maps its container to 5433, not 5432. A local PostgreSQL install
# owning 5432 is common on developer machines, and the clash is silent:
# Docker still starts, but host connections reach the wrong server.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_SUPERUSER=rasta
POSTGRES_SUPERUSER_PASSWORD=rasta_dev_password
# Shared password for the per-service roles created by the init script (dev only).
POSTGRES_SERVICE_PASSWORD=rasta_service_dev_password

DATABASE_URL_IDENTITY=postgresql://rasta_identity:rasta_service_dev_password@localhost:5433/rasta_identity?schema=public
DATABASE_URL_ORGANIZATION=postgresql://rasta_organization:rasta_service_dev_password@localhost:5433/rasta_organization?schema=public
DATABASE_URL_ASSET=postgresql://rasta_asset:rasta_service_dev_password@localhost:5433/rasta_asset?schema=public
DATABASE_URL_FLEET=postgresql://rasta_fleet:rasta_service_dev_password@localhost:5433/rasta_fleet?schema=public
DATABASE_URL_MAINTENANCE=postgresql://rasta_maintenance:rasta_service_dev_password@localhost:5433/rasta_maintenance?schema=public
DATABASE_URL_MARKETPLACE=postgresql://rasta_marketplace:rasta_service_dev_password@localhost:5433/rasta_marketplace?schema=public
DATABASE_URL_PROCUREMENT=postgresql://rasta_procurement:rasta_service_dev_password@localhost:5433/rasta_procurement?schema=public
DATABASE_URL_SUPPLIER=postgresql://rasta_supplier:rasta_service_dev_password@localhost:5433/rasta_supplier?schema=public
DATABASE_URL_INVENTORY=postgresql://rasta_inventory:rasta_service_dev_password@localhost:5433/rasta_inventory?schema=public
DATABASE_URL_CONSTRUCTION=postgresql://rasta_construction:rasta_service_dev_password@localhost:5433/rasta_construction?schema=public
DATABASE_URL_CONTRACT=postgresql://rasta_contract:rasta_service_dev_password@localhost:5433/rasta_contract?schema=public
DATABASE_URL_ECONOMIC=postgresql://rasta_economic:rasta_service_dev_password@localhost:5433/rasta_economic?schema=public
DATABASE_URL_NOTIFICATION=postgresql://rasta_notification:rasta_service_dev_password@localhost:5433/rasta_notification?schema=public
DATABASE_URL_DOCUMENT=postgresql://rasta_document:rasta_service_dev_password@localhost:5433/rasta_document?schema=public
DATABASE_URL_AUDIT=postgresql://rasta_audit:rasta_service_dev_password@localhost:5433/rasta_audit?schema=public
DATABASE_URL_ANALYTICS=postgresql://rasta_analytics:rasta_service_dev_password@localhost:5433/rasta_analytics?schema=public

# ---------- Redis -----------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------- Kafka -----------------------------------------------------------
# The host port the broker is published on. 9092 works almost everywhere, but
# Windows reserves dynamic port ranges that can swallow it — check with
# `netsh interface ipv4 show excludedportrange protocol=tcp` if Docker refuses
# to publish it, and pick a port outside every listed range. Same class of
# clash as POSTGRES_PORT above, and the advertised listener follows this value.
KAFKA_HOST_PORT=9092
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=rasta
KAFKA_SCHEMA_STRICT=true

# ---------- Keycloak / OIDC -------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=rasta
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
# Confidential client used by backend services for the admin API and token exchange.
KEYCLOAK_BACKEND_CLIENT_ID=rasta-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=backend_dev_secret_change_me
# Public client used by the web/admin frontends (PKCE, no secret).
KEYCLOAK_WEB_CLIENT_ID=rasta-web
OIDC_ISSUER_URL=http://localhost:8080/realms/rasta
OIDC_JWKS_URI=http://localhost:8080/realms/rasta/protocol/openid-connect/certs
OIDC_AUDIENCE=rasta-api

# ---------- Object storage (S3-compatible, MinIO in dev) --------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rasta_minio_admin
S3_SECRET_KEY=rasta_minio_dev_password
S3_BUCKET_DOCUMENTS=rasta-documents
S3_FORCE_PATH_STYLE=true

# ---------- Temporal --------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=rasta-main
# marketplace-service owns its own queue (ADR-039). A shared queue would hand
# one service's worker another service's workflow tasks.
MARKETPLACE_TEMPORAL_TASK_QUEUE=rasta-order
MARKETPLACE_TEMPORAL_ENABLED=true
# Order windows (ADR-043, Q-11). Expiry records a reminder and never moves
# money: there is no automatic receipt confirmation.
MARKETPLACE_FULFILLMENT_WINDOW_DAYS=7
MARKETPLACE_RECEIPT_WINDOW_DAYS=3
MARKETPLACE_REMINDER_INTERVAL_DAYS=3

# ---------- Search ----------------------------------------------------------
OPENSEARCH_NODE=http://localhost:9200

# ---------- Observability ---------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_ENABLED=true
OTEL_SERVICE_NAMESPACE=rasta

# ---------- Service ports ---------------------------------------------------
# If a port here is already in use on your machine, override it in .env rather
# than changing this file. Port 3000 in particular is claimed by almost every
# Node tool, and the failure is confusing: the service appears to start and
# then something else answers its requests.
PORT_API_GATEWAY=3000
PORT_IDENTITY=3101
PORT_ORGANIZATION=3102
PORT_ASSET=3103
PORT_FLEET=3104
PORT_MAINTENANCE=3105
PORT_MARKETPLACE=3106
PORT_PROCUREMENT=3107
PORT_SUPPLIER=3108
PORT_INVENTORY=3109
PORT_CONSTRUCTION=3110
PORT_CONTRACT=3111
PORT_ECONOMIC=3112
PORT_NOTIFICATION=3113
PORT_DOCUMENT=3114
PORT_AUDIT=3115
PORT_ANALYTICS=3116

# ---------- Internal service URLs (gateway -> service) ----------------------
IDENTITY_SERVICE_URL=http://localhost:3101
ORGANIZATION_SERVICE_URL=http://localhost:3102
ASSET_SERVICE_URL=http://localhost:3103
FLEET_SERVICE_URL=http://localhost:3104
MAINTENANCE_SERVICE_URL=http://localhost:3105
MARKETPLACE_SERVICE_URL=http://localhost:3106
PROCUREMENT_SERVICE_URL=http://localhost:3107
SUPPLIER_SERVICE_URL=http://localhost:3108
INVENTORY_SERVICE_URL=http://localhost:3109
CONSTRUCTION_SERVICE_URL=http://localhost:3110
CONTRACT_SERVICE_URL=http://localhost:3111
ECONOMIC_SERVICE_URL=http://localhost:3112
NOTIFICATION_SERVICE_URL=http://localhost:3113
DOCUMENT_SERVICE_URL=http://localhost:3114
AUDIT_SERVICE_URL=http://localhost:3115
ANALYTICS_SERVICE_URL=http://localhost:3116

# ---------- Service-to-service authentication (Zero Trust) ------------------
# Dev uses a signed internal token; production uses mTLS + workload identity.
INTERNAL_TOKEN_SECRET=internal_dev_secret_change_me_at_least_32_chars
INTERNAL_TOKEN_ISSUER=rasta-internal

# ---------- Economic service ------------------------------------------------
# The organization that plays the platform operator role. Escrow is per
# organization (ADR-034), but commission revenue, reward expense and the
# simulated payment clearing account belong to this one. Configuration rather
# than a constant, so the platform stays organization-agnostic (AGENTS.md A-05).
ECONOMIC_PLATFORM_ORGANIZATION_ID=ORG-PLATFORM
# The only implementation that exists. There is NO bank connection, NO custody
# of funds and NO real money movement (ADR-024). A value other than `mock` is
# rejected at boot rather than silently falling back.
ECONOMIC_PAYMENT_PROVIDER=mock
# Fixed simulated latency, never random — a random delay makes a test flaky
# rather than realistic. Raise it in a demo environment.
ECONOMIC_MOCK_PAYMENT_LATENCY_MS=0
# Cashback is conditioned on a regulatory review that has not concluded
# (docs/24 Q-07). With this off, creating a CASHBACK rule is refused rather
# than silently ignored.
ECONOMIC_REWARD_CASHBACK_ENABLED=false
# How long a stored idempotency key is honoured (docs/06 § 6.8).
ECONOMIC_IDEMPOTENCY_TTL_HOURS=24
# The wallet/ledger reconciliation (docs/10 § 10.3). It reports deviations and
# never repairs them: a wallet that disagrees with its ledger is an incident
# for a human, not a number to quietly correct.
ECONOMIC_BALANCE_AUDIT_ENABLED=true
ECONOMIC_BALANCE_AUDIT_INTERVAL_SECONDS=3600
ECONOMIC_BALANCE_AUDIT_BATCH_SIZE=500
# Seeds one sample commission rule and one sample reward rule, both labelled
# "نمونه — نیازمند تصویب". Off by default so no environment acquires an
# unapproved rate by accident (ADR-023, docs/24 Q-08).
ECONOMIC_SEED_SAMPLE_RULES=false

# ---------- API Gateway -----------------------------------------------------
GATEWAY_CORS_ORIGINS=http://localhost:3200,http://localhost:3201
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
GATEWAY_RATE_LIMIT_MAX=300

# ---------- Frontend --------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=rasta
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=rasta-web

# ---------- End-to-end tests (tests/e2e) ------------------------------------
# Only needed to run `pnpm test:e2e`, and every one of them has a default that
# matches the rest of this file — so a stack started with `pnpm infra:up` plus
# api-gateway and economic-service needs none of them set. Override when a port
# differs on your machine, as KAFKA_HOST_PORT and PORT_API_GATEWAY sometimes do.
#
# There is no password here. The suite reads the throwaway development one from
# infrastructure/docker/keycloak/rasta-realm.json, which already owns it —
# a second copy would be a second thing to keep in step and a second thing for
# a secret scanner to find. E2E_USER_PASSWORD overrides it for an environment
# whose realm was provisioned elsewhere.
E2E_GATEWAY_URL=http://localhost:3000
E2E_ECONOMIC_URL=http://localhost:3112
