# -----------------------------------------------------------------------------
# Database OWNER credentials — migration tooling only (D-045).
#
# `rasta_<svc>_migrator` owns its service's database and every object in it:
# it can DISABLE a trigger, DROP a constraint, rewrite the migration ledger.
# The service itself connects as `rasta_<svc>` (DML only, .env). These
# credentials are therefore kept out of .env, which every service's `start` and
# `dev` load, and every service refuses to boot if a *_MIGRATOR variable is in
# its environment (@rasta/config assertNoMigratorCredentials).
#
#   cp .env.migrator.example .env.migrator     (git-ignored; real environments
#                                               set their own values)
#
# Read by: each service's `db:migrate` / `db:migrate:dev` (scripts/prisma.mjs,
# which requires the migrator URL for a split service and never falls back to
# the runtime one); compose's postgres container (env_file — the bootstrap
# creates each migrator with its password); the integration suites, whose
# cleanup lifts a trigger only through the owner connection — export both
# files for them:  set -a; . ./.env; . ./.env.migrator; set +a
#
# Dev values only. URL-safe ([A-Za-z0-9_.~-], 16+), distinct from every other
# role's and the superuser's (the bootstrap and `pnpm infra:up` refuse
# duplicates). Rotate an existing volume with `pnpm db:rotate-role-passwords`.
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD_AUDIT_MIGRATOR=rasta_audit_migrator_dev_password
POSTGRES_PASSWORD_SUPPLIER_MIGRATOR=rasta_supplier_migrator_dev_password
POSTGRES_PASSWORD_CONSTRUCTION_MIGRATOR=rasta_construction_migrator_dev_password
POSTGRES_PASSWORD_IDENTITY_MIGRATOR=rasta_identity_migrator_dev_password
POSTGRES_PASSWORD_NOTIFICATION_MIGRATOR=rasta_notification_migrator_dev_password

DATABASE_URL_AUDIT_MIGRATOR=postgresql://rasta_audit_migrator:rasta_audit_migrator_dev_password@127.0.0.1:5433/rasta_audit?schema=audit
DATABASE_URL_SUPPLIER_MIGRATOR=postgresql://rasta_supplier_migrator:rasta_supplier_migrator_dev_password@127.0.0.1:5433/rasta_supplier?schema=public
DATABASE_URL_CONSTRUCTION_MIGRATOR=postgresql://rasta_construction_migrator:rasta_construction_migrator_dev_password@127.0.0.1:5433/rasta_construction?schema=public
DATABASE_URL_IDENTITY_MIGRATOR=postgresql://rasta_identity_migrator:rasta_identity_migrator_dev_password@127.0.0.1:5433/rasta_identity?schema=public
DATABASE_URL_NOTIFICATION_MIGRATOR=postgresql://rasta_notification_migrator:rasta_notification_migrator_dev_password@127.0.0.1:5433/rasta_notification?schema=public
