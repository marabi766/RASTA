# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Turbo
.turbo/

# Tests / coverage
coverage/
.nyc_output/
test-results/
playwright-report/

# Environment — NEVER commit real secrets
.env
.env.*
!.env.example
!.env.migrator.example
*.pem
*.key
!infrastructure/**/*.example.key

# Prisma generated client
**/src/generated/
**/node_modules/.prisma/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# Editors / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
.DS_Store
Thumbs.db

# Docker volumes mounted locally
.docker-data/

# RUN-006: the local broker's throwaway CA certificate, copied out of the
# kafka-tls docker volume for the services on the host. Generated, never committed.
infrastructure/docker/kafka/.tls/
# RUN-006: local overrides of the bootstrap-only Kafka credentials (the
# committed bootstrap.env.example holds the development defaults).
infrastructure/docker/kafka/bootstrap.env
