# Hoisting is disabled by default in pnpm. NestJS + Prisma need a few packages
# resolvable from the service root, so we expose them explicitly.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@prisma/*
public-hoist-pattern[]=prisma
strict-peer-dependencies=false
auto-install-peers=true

# Supply-chain policy for anyone who runs npm here (this repository installs with
# pnpm, whose equivalent — minimumReleaseAge — lives in pnpm-workspace.yaml).
# Seven days, the same window. D-008, docs/23.
min-release-age=7
