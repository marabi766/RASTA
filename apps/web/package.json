    "clsx": "^2.1.1",
    "date-fns-jalali": "4.4.0-0",
    "jose": "^5.9.6",
    "lucide-react": "^1.47.0",
    "next": "15.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
