{
  "name": "@rasta/web",
  "version": "0.1.0",
  "private": true,
  "description": "Rasta user portal — Persian-first RTL Next.js application talking to the API Gateway.",
  "scripts": {
    "build": "next build",
    "clean": "rimraf .next .turbo coverage playwright-report test-results",
    "dev": "next dev --port 3200",
    "start": "next start --port 3200",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:unit": "jest",
    "test:coverage": "jest --coverage",
    "test:ui": "playwright test",
    "screens": "playwright test --config playwright.screens.config.ts",
    "analyze:bundle": "node scripts/bundle-budget.mjs"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "@rasta/contracts": "workspace:*",
    "next": "15.5.25",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@swc/core": "^1.10.7",
    "@swc/jest": "^0.2.37",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.18.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "jest-axe": "^9.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
