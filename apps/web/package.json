{
  "name": "@rasta/web",
  "version": "0.1.0",
  "private": true,
  "description": "Rasta user portal — a Persian-first, right-to-left Next.js application that talks only to the API Gateway.",
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start --port 3200",
    "lint": "eslint src",
