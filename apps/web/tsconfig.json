{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The base config targets Node services: CommonJS modules and an ES2023
    // library with no DOM. A browser bundle needs the opposite on all three,
    // so these are overrides of intent, not drift.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "isolatedModules": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] },
    "types": ["jest", "node", "@testing-library/jest-dom"]
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "coverage"]
}
