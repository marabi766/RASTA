{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // Contract specs read other packages' **source as text** to pin the portal's
    // copy of a rule to the original (`*.contract.spec.ts`: A-02 forbids
    // importing `services/*/src`, so the portal keeps copies and a test compares
    // them). Those files live outside this package, so without naming them here
    // a change to one would replay a cached green for the very test meant to
    // catch it. Entries are per-directory globs, so a new file in a listed
    // directory needs no edit here (the price: a change to any file in those
    // directories re-runs this package's tests). This list is not a convention
    // to remember: `src/test/turbo-inputs-guard.ts` fails any spec that reads
    // a file outside this package that no pattern below matches, and
    // `src/turbo-config.spec.ts` keeps the two lists equal and every pattern
    // matching at least one file.
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/contracts/**",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/packages/nest-common/src/**",
        "$TURBO_ROOT$/services/api-gateway/src/**",
        "$TURBO_ROOT$/services/asset-service/src/**",
        "$TURBO_ROOT$/services/construction-service/prisma/schema.prisma",
        "$TURBO_ROOT$/services/construction-service/src/**",
        "$TURBO_ROOT$/services/contract-service/src/**",
        "$TURBO_ROOT$/services/document-service/src/**",
        "$TURBO_ROOT$/services/economic-service/prisma/migrations/**",
        "$TURBO_ROOT$/services/economic-service/src/**",
        "$TURBO_ROOT$/services/fleet-service/src/**",
        "$TURBO_ROOT$/services/inventory-service/src/**",
        "$TURBO_ROOT$/services/maintenance-service/src/**",
        "$TURBO_ROOT$/services/marketplace-service/src/**"
      ]
    },
    "test:unit": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/contracts/**",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/packages/nest-common/src/**",
        "$TURBO_ROOT$/services/api-gateway/src/**",
        "$TURBO_ROOT$/services/asset-service/src/**",
        "$TURBO_ROOT$/services/construction-service/prisma/schema.prisma",
        "$TURBO_ROOT$/services/construction-service/src/**",
        "$TURBO_ROOT$/services/contract-service/src/**",
        "$TURBO_ROOT$/services/document-service/src/**",
        "$TURBO_ROOT$/services/economic-service/prisma/migrations/**",
        "$TURBO_ROOT$/services/economic-service/src/**",
        "$TURBO_ROOT$/services/fleet-service/src/**",
        "$TURBO_ROOT$/services/inventory-service/src/**",
        "$TURBO_ROOT$/services/maintenance-service/src/**",
        "$TURBO_ROOT$/services/marketplace-service/src/**"
      ]
    }
  }
}
