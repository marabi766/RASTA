              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          },
          "default": {
            "description": "Platform error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "summary": "Update a user profile",
        "tags": ["identity"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^(?![\\s\\S]*\\p{Bidi_Control})[\\p{Script=Arabic}\\p{Script=Latin}\\p{Mark}\\s‌'’\\-.]+$"
                  },
                  "lastName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^(?![\\s\\S]*\\p{Bidi_Control})[\\p{Script=Arabic}\\p{Script=Latin}\\p{Mark}\\s‌'’\\-.]+$"
                  },
                  "phone": {
                    "type": "string",
                    "pattern": "^(?:\\+98|0)9\\d{9}$",
                    "nullable": true
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/users/{id}/memberships": {
      "post": {
        "operationId": "UserController_addMembership_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": ""
          },
          "default": {
            "description": "Platform error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "summary": "Add the user to an organization",
        "tags": ["identity"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "organizationId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^ORG_[0-9A-HJKMNP-TV-Z]{26}$",
                        "description": "ORG identifier"
                      },
                      {
                        "type": "string",
                        "pattern": "^ORG-[A-Z0-9-]{1,48}$"
                      }
                    ]
                  },
                  "roles": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "SYSTEM_ADMIN",
                        "UNION_ADMIN",
                        "ORGANIZATION_ADMIN",
                        "FLEET_MANAGER",
                        "DRIVER",
                        "OPERATOR",
                        "PROCUREMENT_USER",
                        "SUPPLIER",
                        "WORKSHOP",
                        "CONTRACTOR",
                        "AUDITOR"
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 11
                  },
                  "validUntil": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "Z$",
                    "description": "ISO 8601 instant that ends in `Z` (UTC); a numeric offset (`+03:30`) is invalid here."
                  }
                },
                "required": ["organizationId", "roles"],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/memberships/{id}/roles": {
      "post": {
        "description": "A change that removes a role is written to the identity provider before it commits (ADR-060, D-064). Refused with 503 KEYCLOAK_UNAVAILABLE, nothing changed and no event, when the provider cannot be written; with 503 KEYCLOAK_WRITE_SETTLING and `Retry-After` while an earlier write of the same user may still land (D-069) — only after the caller was authorized for this membership. Sending the same roles again answers the same and emits nothing.",
        "operationId": "MembershipController_updateRoles_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          },
          "default": {
            "description": "Platform error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "summary": "Replace the roles held in this organization",
        "tags": ["identity"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "roles": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "SYSTEM_ADMIN",
                        "UNION_ADMIN",
                        "ORGANIZATION_ADMIN",
                        "FLEET_MANAGER",
                        "DRIVER",
                        "OPERATOR",
                        "PROCUREMENT_USER",
                        "SUPPLIER",
                        "WORKSHOP",
                        "CONTRACTOR",
                        "AUDITOR"
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 11
                  },
                  "reason": {
                    "type": "string",
                    "pattern": "^[^\\p{Bidi_Control}]*$",
                    "minLength": 3,
                    "maxLength": 500
                  }
                },
                "required": ["roles", "reason"],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/memberships/{id}/revoke": {
      "post": {
        "description": "Written to the identity provider before it commits (ADR-060, D-064). Refused with 503 KEYCLOAK_UNAVAILABLE, the membership still live and no event, when the provider cannot be written; with 503 KEYCLOAK_WRITE_SETTLING and `Retry-After` while an earlier write of the same user may still land (D-069) — only after the caller was authorized for this membership. Revoking an ended membership again answers 204 and emits nothing.",
        "operationId": "MembershipController_revoke_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "default": {
            "description": "Platform error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "summary": "Revoke a membership",
        "tags": ["identity"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "pattern": "^[^\\p{Bidi_Control}]*$",
                    "minLength": 3,
                    "maxLength": 500
                  }
                },
                "required": ["reason"],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/registration-requests": {
      "post": {
        "description": "Always answers 202 `{\"status\":\"RECEIVED\"}` to a valid request, whether a reviewable request was recorded or the username or email is already held: the answer never says which, so the endpoint cannot be used to learn who has an account. A reviewer finds recorded requests through the review process, not through this answer.",
        "operationId": "RegistrationController_submit_v1",
        "parameters": [],
        "responses": {
          "202": {
            "description": ""
          },
          "default": {
            "description": "Platform error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "summary": "Submit a request to join the platform",
        "tags": ["identity"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 64,
                    "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 255
                  },
                  "firstName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^(?![\\s\\S]*\\p{Bidi_Control})[\\p{Script=Arabic}\\p{Script=Latin}\\p{Mark}\\s‌'’\\-.]+$"
                  },
                  "lastName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^(?![\\s\\S]*\\p{Bidi_Control})[\\p{Script=Arabic}\\p{Script=Latin}\\p{Mark}\\s‌'’\\-.]+$"
                  },
                  "phone": {
                    "type": "string",
                    "pattern": "^(?:\\+98|0)9\\d{9}$"
                  },
                  "requestedOrganizationId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^ORG_[0-9A-HJKMNP-TV-Z]{26}$",
                        "description": "ORG identifier"
                      },
                      {
                        "type": "string",
                        "pattern": "^ORG-[A-Z0-9-]{1,48}$"
                      }
                    ]
                  },
                  "requestedRoles": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "SYSTEM_ADMIN",
                        "UNION_ADMIN",
                        "ORGANIZATION_ADMIN",
                        "FLEET_MANAGER",
                        "DRIVER",
                        "OPERATOR",
                        "PROCUREMENT_USER",
                        "SUPPLIER",
                        "WORKSHOP",
                        "CONTRACTOR",
                        "AUDITOR"
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 11
                  },
                  "justification": {
                    "type": "string",
                    "pattern": "^[^\\p{Bidi_Control}]*$",
                    "maxLength": 1000
                  },
                  "documentRefs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[^\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}\\p{Bidi_Control}]*$",
                      "minLength": 1
                    },
                    "maxItems": 10,
                    "default": []
                  }
                },
                "required": [
                  "username",
                  "email",
                  "firstName",
                  "lastName",
                  "requestedOrganizationId",
                  "requestedRoles"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      },
      "get": {
        "description": "Requests for the organizations the reviewer may provision into (their own, or every organization for a role in USER_PROVISIONING_CROSS_ORG_ROLES), oldest first, filtered by `status` and the exact `username`. The submission answer carries no id, so this is where a reviewer finds a request.",
        "operationId": "RegistrationController_listRequests_v1",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 25
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["PENDING", "APPROVED", "REJECTED"]
            }
          },
          {
            "name": "username",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 64,
              "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          },
          "default": {
            "description": "Platform error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "summary": "The registration review queue",
        "tags": ["identity"]
      }
    },
    "/v1/registration-requests/{id}/approve": {
      "post": {
        "description": "Refused with 409 ALREADY_EXISTS, the registration staying PENDING and nothing approved, when its `details[0].code` is MEMBERSHIP_ALREADY_LIVE (the applicant was given a live membership in the requested organization meanwhile) or ACCOUNT_NOT_FROM_THIS_REGISTRATION (the identity provider holds an account under the username that this registration did not create), and with 409 INVALID_STATE_TRANSITION when another decision on it committed first. Refused with 503 UPSTREAM_UNAVAILABLE and `details[0].code` ACCOUNT_NOT_CONFIRMED, the registration staying PENDING, when the identity provider answered the account creation without its id and no such account can be found; a retry resolves it. The account is enabled only after the approval commits, once; a retry after any failure adopts the account an earlier attempt created, disabling it and clearing its grants first if it is enabled or holds any.",
        "operationId": "RegistrationController_approve_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          },
          "default": {
            "description": "Platform error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "summary": "Approve a registration and provision the account",
        "tags": ["identity"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "roles": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "SYSTEM_ADMIN",
                        "UNION_ADMIN",
                        "ORGANIZATION_ADMIN",
                        "FLEET_MANAGER",
                        "DRIVER",
                        "OPERATOR",
                        "PROCUREMENT_USER",
                        "SUPPLIER",
                        "WORKSHOP",
                        "CONTRACTOR",
                        "AUDITOR"
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 11
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/registration-requests/{id}/reject": {
      "post": {
        "description": "Decided under the registration request lock, as approval is: when another decision on the same registration committed first, refused with 409 INVALID_STATE_TRANSITION and nothing written or emitted.",
        "operationId": "RegistrationController_reject_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          },
          "default": {
            "description": "Platform error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "summary": "Reject a registration, with a required reason",
        "tags": ["identity"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "pattern": "^[^\\p{Bidi_Control}]*$",
                    "minLength": 10,
                    "maxLength": 1000
                  }
                },
                "required": ["reason"],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/audit-corrections": {
      "post": {
        "description": "Never edits the original. Enqueues one `AUDIT_EVENT_RECORDED` v1 message on `rasta.audit.trail.v1`, which audit-service records as a new record whose `correctionOf` names the target; the original then lists it in `correctedBy`. `occurredAt` must equal the target’s own instant. The target’s organization is taken from audit-service, never from the request. A missing target, or one at a different instant, answers `404` and writes nothing. `202` means accepted for recording, not yet readable: the record appears once audit-service has ingested it.",
        "operationId": "AuditCorrectionController_submit_v1",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Mandatory. The same key with the same request replays the original `202`; with a different request it is refused with `409 IDEMPOTENCY_KEY_REUSED`.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": ""
          },
          "default": {
            "description": "Platform error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "summary": "Correct an audit record by appending a linked correction (SYSTEM_ADMIN)",
        "tags": ["audit-corrections"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "auditEventId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[0-9A-Za-z_-]+$"
                  },
                  "occurredAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "(?:Z|[+-](?:(?:0\\d|1[0-3]):?[0-5]\\d|14:?00))$",
                    "description": "ISO 8601 instant that ends in `Z` or a numeric offset within ±14:00 (`+03:30`, `+0330`); an offset beyond ±14:00, which RFC 3339 allows, is invalid here."
                  },
                  "reason": {
                    "type": "string",
                    "pattern": "^[^\\p{Bidi_Control}]*$",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "changes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "field": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "from": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "maxLength": 2000
                                },
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "boolean"
                                },
                                {}
                              ]
                            },
                            {
                              "type": "object",
                              "properties": {
                                "redacted": {
                                  "const": true
                                }
                              },
                              "required": ["redacted"],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "hash": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 128
                                }
                              },
                              "required": ["hash"],
                              "additionalProperties": false
                            }
                          ]
                        },
                        "to": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "maxLength": 2000
                                },
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "boolean"
                                },
                                {}
                              ]
                            },
                            {
                              "type": "object",
                              "properties": {
                                "redacted": {
                                  "const": true
                                }
                              },
                              "required": ["redacted"],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "hash": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 128
                                }
                              },
                              "required": ["hash"],
                              "additionalProperties": false
                            }
                          ]
                        }
                      },
                      "required": ["field", "from", "to"],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 50
                  }
                },
                "required": ["auditEventId", "occurredAt", "reason", "changes"],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
