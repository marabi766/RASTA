    "/v1/users": {
      "get": {
        "operationId": "UserController_list_v1",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 25
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["PENDING", "ACTIVE", "SUSPENDED", "DEACTIVATED"]
            }
          },
          {
            "name": "role",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "SYSTEM_ADMIN",
                "UNION_ADMIN",
                "ORGANIZATION_ADMIN",
                "FLEET_MANAGER",
                "DRIVER",
                "OPERATOR",
                "PROCUREMENT_USER",
                "SUPPLIER",
                "WORKSHOP",
                "CONTRACTOR",
                "AUDITOR"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          },
          "default": {
            "description": "Platform error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "summary": "List users in the requesting organization",
        "tags": ["identity"]
      },
      "post": {
        "description": "Requires an `Idempotency-Key` (400 VALIDATION_FAILED without one). The request is recorded with the user id before the identity-provider account is created, so the same request again — same caller, key, acting organization and body — finishes it: it creates under that id, adopts the account an earlier attempt created, or replays the answer once the user committed. The same key with another body or acting organization: 409 IDEMPOTENCY_KEY_REUSED. A username or email already held, or an account under the username that this request did not create: 409 ALREADY_EXISTS.",
        "operationId": "UserController_create_v1",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          },
          "default": {
            "description": "Platform error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "summary": "Create an already-approved user",
        "tags": ["identity"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 64,
                    "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 255
                  },
                  "firstName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^(?![\\s\\S]*\\p{Bidi_Control})[\\p{Script=Arabic}\\p{Script=Latin}\\p{Mark}\\s‌'’\\-.]+$"
                  },
                  "lastName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^(?![\\s\\S]*\\p{Bidi_Control})[\\p{Script=Arabic}\\p{Script=Latin}\\p{Mark}\\s‌'’\\-.]+$"
                  },
                  "phone": {
                    "type": "string",
                    "pattern": "^(?:\\+98|0)9\\d{9}$"
                  },
                  "organizationId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^ORG_[0-9A-HJKMNP-TV-Z]{26}$",
                        "description": "ORG identifier"
                      },
                      {
                        "type": "string",
                        "pattern": "^ORG-[A-Z0-9-]{1,48}$"
                      }
                    ]
                  },
                  "roles": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "SYSTEM_ADMIN",
                        "UNION_ADMIN",
                        "ORGANIZATION_ADMIN",
                        "FLEET_MANAGER",
                        "DRIVER",
                        "OPERATOR",
                        "PROCUREMENT_USER",
                        "SUPPLIER",
                        "WORKSHOP",
                        "CONTRACTOR",
                        "AUDITOR"
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 11
                  }
                },
                "required": [
                  "username",
                  "email",
                  "firstName",
                  "lastName",
                  "organizationId",
                  "roles"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/users/{id}/organizations": {
      "get": {
        "description": "Service-to-service only: `construction-service` or `procurement-service` with a token signed for no tenant, in `X-Internal-Token`; a person, any other service, or a token signed for a tenant is refused 403. Live memberships only, judged on the database clock. With `from`, the organizations the user held a membership in at any time between `from` and the database clock as the query ran (ids only). Used to check a conflict of interest around a bid opening, and around an RFQ opening, evaluation, selection and approval (ADR-070 § 7).",
        "operationId": "UserController_liveOrganizations_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$",
              "description": "ISO 8601 instant that ends in `Z` (UTC); a numeric offset (`+03:30`) is invalid here."
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          },
          "default": {
            "description": "Platform error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "internalToken": []
          }
        ],
        "summary": "The organizations a user belongs to now, with the roles held in each",
        "tags": ["identity"]
      }
    },
    "/v1/users/{id}/live-membership": {
      "get": {
        "description": "Service-to-service only: `fleet-service` with a token signed for a tenant, in `X-Internal-Token`; a person, any other service, or a token signed for no tenant is refused 403. The organization is the signed one, never a parameter. Answers `{ userId, organizationId, live, asOf }`: live = an ACTIVE, not deleted membership whose validity window holds the database clock, of an ACTIVE, not deleted user. A user who does not exist gets the same `live: false` as one who belongs elsewhere. Used before a driver is registered.",
        "operationId": "UserController_liveMembership_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          },
          "default": {
            "description": "Platform error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "internalToken": []
          }
        ],
        "summary": "Whether a user is a live member of the organization the caller acts for",
        "tags": ["identity"]
      }
    },
