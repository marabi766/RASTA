  "info": {
    "title": "Rasta — Identity Service",
    "description": "Source of truth for who you are and what role you hold in which organization. Keycloak owns authentication; this service owns membership.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "internalToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-token",
        "description": "A signed internal service token minted for identity-service (ADR-020). `GET /v1/users/{id}/organizations` takes it, signed for no tenant, and `GET /v1/users/{id}/live-membership` signed for a tenant, instead of the bearer."
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              },
              "required": ["path", "message"],
              "additionalProperties": false
            }
          },
          "correlationId": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$",
            "description": "ISO 8601 instant that ends in `Z` (UTC); a numeric offset (`+03:30`) is invalid here."
          },
          "path": {
            "type": "string"
          }
        },
        "required": ["code", "message", "correlationId", "timestamp"],
        "additionalProperties": false
      }
    }
  }
}
