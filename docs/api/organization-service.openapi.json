{
  "openapi": "3.0.3",
  "paths": {
    "/v1/organizations/{id}/procurement-thresholds": {
      "get": {
        "description": "Service callers only (construction-service). Person/session callers and other services receive 403. The signed token organization must equal the requested id exactly, including when it is an ancestor: otherwise generic 404 without existence details. Returns only the effective inherited-resolved construction.tender.procurement_thresholds key, or null when absent. Bounds are inclusive integer rial strings; minimum must not exceed maximum. Governance values are stored as configured; malformed values fail closed at the construction consumer.",
        "operationId": "OrganizationController_procurementThresholds",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One effective policy or explicit null",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "organizationId": {
                      "type": "string"
                    },
                    "policy": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
                          "type": "object",
                          "properties": {
                            "FORMAL_TENDER": {
                              "type": "object",
                              "properties": {
                                "minAmountMinor": {
                                  "type": "string",
                                  "pattern": "^[0-9]+$",
                                  "nullable": true
                                },
                                "maxAmountMinor": {
                                  "type": "string",
                                  "pattern": "^[0-9]+$",
                                  "nullable": true
                                },
                                "mode": {
                                  "type": "string",
                                  "enum": ["WARN", "REJECT"]
                                }
                              },
                              "required": ["minAmountMinor", "maxAmountMinor", "mode"],
                              "additionalProperties": false
                            },
                            "INQUIRY": {
                              "type": "object",
                              "properties": {
                                "minAmountMinor": {
                                  "type": "string",
                                  "pattern": "^[0-9]+$",
                                  "nullable": true
                                },
                                "maxAmountMinor": {
                                  "type": "string",
                                  "pattern": "^[0-9]+$",
                                  "nullable": true
                                },
                                "mode": {
                                  "type": "string",
                                  "enum": ["WARN", "REJECT"]
                                }
                              },
                              "required": ["minAmountMinor", "maxAmountMinor", "mode"],
                              "additionalProperties": false
                            },
                            "RFP": {
                              "type": "object",
                              "properties": {
                                "minAmountMinor": {
                                  "type": "string",
                                  "pattern": "^[0-9]+$",
                                  "nullable": true
                                },
                                "maxAmountMinor": {
                                  "type": "string",
                                  "pattern": "^[0-9]+$",
                                  "nullable": true
                                },
                                "mode": {
                                  "type": "string",
                                  "enum": ["WARN", "REJECT"]
                                }
                              },
                              "required": ["minAmountMinor", "maxAmountMinor", "mode"],
                              "additionalProperties": false
                            },
                            "MARKETPLACE_DEAL": {
                              "type": "object",
                              "properties": {
                                "minAmountMinor": {
                                  "type": "string",
                                  "pattern": "^[0-9]+$",
                                  "nullable": true
                                },
                                "maxAmountMinor": {
                                  "type": "string",
                                  "pattern": "^[0-9]+$",
                                  "nullable": true
                                },
                                "mode": {
                                  "type": "string",
                                  "enum": ["WARN", "REJECT"]
                                }
                              },
                              "required": ["minAmountMinor", "maxAmountMinor", "mode"],
                              "additionalProperties": false
                            }
                          },
                          "required": ["FORMAL_TENDER", "INQUIRY", "RFP", "MARKETPLACE_DEAL"],
                          "additionalProperties": false
                        }
                      },
                      "required": ["id", "value"],
                      "additionalProperties": false,
                      "nullable": true
                    }
                  },
                  "required": ["organizationId", "policy"],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Person/session caller or another service refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Token organization mismatch or organization absent; no existence details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "default": {
            "description": "Platform error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "summary": "Effective procurement thresholds for construction-service",
        "tags": ["organizations"],
        "security": [
          {
            "internalToken": []
          }
        ]
      }
    }
  },
  "info": {
    "title": "Rasta Organization Service — procurement thresholds",
    "description": "Scoped contract for the procurement-thresholds service read. Other organization routes are documented by the runtime Swagger surface.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "internalToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Token"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
