# -----------------------------------------------------------------------------
# Kafka bootstrap and tool credentials (RUN-006, review of #131 finding 1).
#
# Never in a service's environment: a service that held the admin's password
# could connect as the broker's super user and bypass every ACL. So these are
# NOT in the repository .env that every service loads. Only the broker and
# kafka-init (compose `env_file`) and the host-side ACL apply
# (`pnpm infra:up`, `pnpm kafka:acl:apply`) read this file; the integration
# tests read the observer's, and the replay tool ops-replay's.
#
# Development values only. To change one, copy this file to bootstrap.env
# (git-ignored) next to it: bootstrap.env overrides this example. Recreate the
# broker afterwards (docs/runbooks/kafka-credential-rotation.md).
# -----------------------------------------------------------------------------

# The broker's super user: formats storage, creates topics, applies the ACLs.
KAFKA_SASL_PASSWORD_ADMIN=rasta_admin_kafka_dev_password
# The only principal that writes `.retry` topics and reads dead-letter topics
# (docs/runbooks/replay-dlq.md).
KAFKA_SASL_PASSWORD_OPS_REPLAY=rasta_ops_replay_kafka_dev_password
# The integration and E2E tests' read-only observer (development profile only).
KAFKA_SASL_PASSWORD_ITEST_OBSERVER=rasta_itest_observer_kafka_dev_password
