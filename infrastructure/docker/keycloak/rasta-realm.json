{
  "realm": "rasta",
  "displayName": "Rasta Platform",
  "displayNameHtml": "<b>رستا</b> — Rasta Platform",
  "enabled": "${RASTA_DEV_REALM_GATE}",
  "attributes": {
    "rasta.disposable_stack": "true"
  },
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "verifyEmail": false,
  "defaultLocale": "fa",
  "internationalizationEnabled": true,
  "supportedLocales": ["fa", "en"],
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername(undefined) and passwordHistory(3) and hashAlgorithm(argon2)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "refreshTokenMaxReuse": 0,
  "revokeRefreshToken": true,
  "roles": {
    "realm": [
      {
        "name": "SYSTEM_ADMIN",
        "description": "Platform operator with full technical administration rights"
      },
      {
        "name": "UNION_ADMIN",
        "description": "Union (اتحادیه) platform-management-centre staff; operates the platform"
      },
      {
        "name": "ORGANIZATION_ADMIN",
        "description": "Administrator of a single organization (e.g. a dehyari)"
      },
      {
        "name": "FLEET_MANAGER",
        "description": "Manages assets, drivers and usage for an org"
      },
      {
        "name": "DRIVER",
        "description": "Assigned operator of one or more assets"
      },
      {
        "name": "OPERATOR",
        "description": "Field operator; records usage and reports breakdowns"
      },
      {
        "name": "PROCUREMENT_USER",
        "description": "Raises demand requests and marketplace orders for an org"
      },
      {
        "name": "SUPPLIER",
        "description": "External goods supplier"
      },
      {
        "name": "WORKSHOP",
        "description": "External repair workshop / service provider"
      },
      {
        "name": "CONTRACTOR",
        "description": "Civil-works contractor bidding on tenders"
      },
      {
        "name": "AUDITOR",
        "description": "Read-only governance oversight (province); aggregate dashboards only"
      }
    ]
  },
  "clients": [
    {
      "clientId": "rasta-web",
      "name": "Rasta Web (public, PKCE)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:3200",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:3200/*",
        "http://localhost:3201/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": ["http://localhost:3200", "http://localhost:3201", "http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3200/*##http://localhost:3201/*"
      },
      "protocolMappers": [
        {
          "name": "active-organization-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "active_organization_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "organization-memberships",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "organization_ids",
            "claim.name": "org_ids",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "rasta-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "rasta-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "rasta-user-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "rasta_user_id",
            "claim.name": "rasta_uid",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "organization-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "organization_roles",
            "claim.name": "org_roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "fullScopeAllowed": true
    },
    {
      "clientId": "rasta-backend",
      "name": "Rasta Backend (confidential, service account)",
      "enabled": true,
      "publicClient": false,
      "secret": "backend_dev_secret_change_me",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "active-organization-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "active_organization_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "organization-memberships",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "organization_ids",
            "claim.name": "org_ids",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
