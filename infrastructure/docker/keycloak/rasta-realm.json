    "port": "1025",
    "from": "no-reply@rasta.local",
    "fromDisplayName": "Rasta Platform",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"rasta_user_id\",\"displayName\":\"Rasta user id\",\"group\":\"rasta-platform\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false,\"validations\":{\"length\":{\"min\":1,\"max\":128},\"pattern\":{\"pattern\":\"^[A-Za-z0-9_-]+$\",\"error-message\":\"rasta-invalid-identifier\"}}},{\"name\":\"active_organization_id\",\"displayName\":\"Active organization\",\"group\":\"rasta-platform\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false,\"validations\":{\"length\":{\"min\":1,\"max\":128},\"pattern\":{\"pattern\":\"^[A-Za-z0-9_-]+$\",\"error-message\":\"rasta-invalid-identifier\"}}},{\"name\":\"organization_ids\",\"displayName\":\"Organization memberships\",\"group\":\"rasta-platform\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":true,\"validations\":{\"length\":{\"min\":1,\"max\":128},\"pattern\":{\"pattern\":\"^[A-Za-z0-9_-]+$\",\"error-message\":\"rasta-invalid-identifier\"}}},{\"name\":\"organization_roles\",\"displayName\":\"Roles per organization\",\"group\":\"rasta-platform\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":true,\"validations\":{\"length\":{\"min\":3,\"max\":192},\"pattern\":{\"pattern\":\"^[A-Za-z0-9_-]+:[A-Z][A-Z_]*$\",\"error-message\":\"rasta-invalid-organization-role\"}}}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"},{\"name\":\"rasta-platform\",\"displayHeader\":\"Rasta platform\",\"displayDescription\":\"Membership facts projected by identity-service. Written only through the Admin API; never visible to or editable by the user.\"}]}"
