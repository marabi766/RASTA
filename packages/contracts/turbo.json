{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // Repository guards read portal/service/shared sources, workspace manifests,
    // scripts, patches and docs. Hash the repository for both test entry points;
    // declarations alone do not yet enforce coverage of future repository reads.
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/**", "!$TURBO_ROOT$/**/node_modules/**"]
    },
    "test:unit": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/**", "!$TURBO_ROOT$/**/node_modules/**"]
    }
  }
}
