{
  "name": "@rasta/nest-common",
  "version": "0.1.0",
  "private": true,
  "description": "Shared NestJS building blocks: request context, guards, filters, interceptors, tenant-scoped repository base, outbox and Kafka wrappers. No business logic.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist .turbo",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --passWithNoTests"
  },
  "dependencies": {
    "@rasta/config": "workspace:*",
    "@rasta/contracts": "workspace:*",
    "@rasta/logging": "workspace:*",
    "jose": "^5.9.6",
    "kafkajs": "^2.2.4",
    "ulid": "^2.3.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@swc/core": "^1.10.7",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.14",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1",
    "typescript": "^5.9.3"
  }
}
