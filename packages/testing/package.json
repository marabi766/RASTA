{
  "name": "@rasta/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Test factories, container helpers and custom matchers. Development dependency only.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist .turbo",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --passWithNoTests"
  },
  "dependencies": {
    "@rasta/contracts": "workspace:*",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@swc/core": "^1.10.7",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.14",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
