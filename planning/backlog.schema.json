{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rasta.local/schemas/backlog.schema.json",
  "title": "RASTA product backlog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "project",
    "asOf",
    "governance",
    "iterations",
    "epics",
    "items",
    "stories",
    "changeLog"
  ],
  "properties": {
    "version": { "const": 2 },
    "project": { "const": "RASTA" },
    "asOf": { "type": "string", "format": "date" },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineState",
        "approvedBy",
        "pointScale",
        "earnedStatus",
        "cancelledStatus",
        "minimumClosedIterationsForForecast"
      ],
      "properties": {
        "baselineState": { "enum": ["PROVISIONAL", "APPROVED"] },
        "approvedBy": { "type": ["string", "null"] },
        "pointScale": { "const": [1, 2, 3, 5, 8, 13, 21] },
        "earnedStatus": { "const": "ACCEPTED" },
        "cancelledStatus": { "const": "CANCELLED" },
        "minimumClosedIterationsForForecast": { "type": "integer", "minimum": 2 }
      }
    },
    "iterations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "status", "startDate", "endDate"],
        "properties": {
          "id": { "type": "string", "pattern": "^IT-[A-Z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PLANNED", "ACTIVE", "CLOSED"] },
          "startDate": { "type": "string", "format": "date" },
          "endDate": { "type": "string", "format": "date" }
        }
      }
    },
    "epics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "scope", "owner"],
        "properties": {
          "id": { "type": "string", "pattern": "^EP-[A-Z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["MVP", "POST_MVP"] },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "epicId",
          "title",
          "scope",
          "priority",
          "points",
          "status",
          "acceptanceCriteria",
          "dependencies",
          "sourceRefs",
          "evidence"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
          "epicId": { "type": "string", "pattern": "^EP-[A-Z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["MVP", "POST_MVP"] },
          "priority": { "enum": ["P0", "P1", "P2", "P3"] },
          "points": { "enum": [1, 2, 3, 5, 8, 13, 21] },
          "status": {
            "enum": ["PROPOSED", "READY", "IN_PROGRESS", "BLOCKED", "ACCEPTED", "CANCELLED"]
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "targetIteration": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "ref", "note"],
              "properties": {
                "kind": { "enum": ["COMMIT", "PR", "CI", "TEST", "RUNTIME", "DOCUMENT"] },
                "ref": { "type": "string", "minLength": 1 },
                "note": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "parentItemId",
          "title",
          "userStory",
          "points",
          "status",
          "acceptanceCriteria",
          "dependencies",
          "sourceRefs",
          "evidence"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
          "parentItemId": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "userStory": {
            "type": "object",
            "additionalProperties": false,
            "required": ["asA", "iWant", "soThat"],
            "properties": {
              "asA": { "type": "string", "minLength": 1 },
              "iWant": { "type": "string", "minLength": 1 },
              "soThat": { "type": "string", "minLength": 1 }
            }
          },
          "points": { "enum": [1, 2, 3, 5, 8, 13, 21] },
          "status": {
            "enum": ["PROPOSED", "READY", "IN_PROGRESS", "BLOCKED", "ACCEPTED", "CANCELLED"]
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["given", "when", "then"],
              "properties": {
                "given": { "type": "string", "minLength": 1 },
                "when": { "type": "string", "minLength": 1 },
                "then": { "type": "string", "minLength": 1 }
              }
            }
          },
          "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "targetIteration": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "ref", "note"],
              "properties": {
                "kind": { "enum": ["COMMIT", "PR", "CI", "TEST", "RUNTIME", "DOCUMENT"] },
                "ref": { "type": "string", "minLength": 1 },
                "note": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "changeLog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "type", "reason", "recordedBy", "approvalRef"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "type": {
            "enum": [
              "BASELINE_CREATED",
              "SCOPE_ADDED",
              "SCOPE_REMOVED",
              "POINTS_CHANGED",
              "STATUS_CORRECTED",
              "BASELINE_APPROVED",
              "ITEM_DECOMPOSED"
            ]
          },
          "reason": { "type": "string", "minLength": 1 },
          "recordedBy": { "type": "string", "minLength": 1 },
          "approvalRef": { "type": ["string", "null"] },
          "recordIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "type": { "const": "ITEM_DECOMPOSED" } },
              "required": ["type"]
            },
            "then": {
              "required": ["recordIds"],
              "properties": { "approvalRef": { "type": "string", "minLength": 1 } }
            }
          }
        ]
      }
    }
  }
}
