// analytics-service — event-driven read models (RUN-001, ADR-071, docs/04 § 4.15).
//
// Everything here is owned by this service alone (AGENTS.md A-01). Facts come from domain
// events, never another service's database; baseline references have no writer yet (Q-142 (1)). There is no
// foreign key into another service: `organizationId`, `requestId`, `assetId` and
// `scheduleId` are external identifiers whose authority is their owner.
//
// ## A fact is one domain fact, append-only
//
// `fact_maintenance` holds one row per completed maintenance request, keyed by the
// organization and the request — the fact's own identity in its owner's domain — so a
// second event about the same completion can never make a second row (ADR-071 § 2). Rows
// are never updated or deleted (`tg_fact_maintenance_append_only`): a contradictory event
// is dead-lettered, never applied over the first.
//
// ## Tenant isolation is in the keys, not only in the guard
//
// `organization_id` — the tenant of the envelope the fact came from — leads every key and
// index. Money is a bigint of minor units with its currency beside it (ADR-022); every
// instant is `timestamptz(3)` (D-048).

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Facts
// ---------------------------------------------------------------------------

/// One completed maintenance request, from `MAINTENANCE_COMPLETED` (ADR-071 § 3, PR 1).
///
/// A historical fact: it stays with the organization the completion was published under, also
/// after the asset is transferred — only the current fleet membership moves (ADR-071 § 3-الف).
/// A terminal fact needs no ordering, so no stream position is kept for it (§ 2 (3)).
model FactMaintenance {
  /// The tenant: the envelope's `tenantId`, proved equal to the payload's organization.
  organizationId  String   @map("organization_id") @db.VarChar(128)
  requestId       String   @map("request_id") @db.VarChar(128)
  assetId         String   @map("asset_id") @db.VarChar(128)
  /// The producer's maintenance type as published (`PREVENTIVE`, `CORRECTIVE` today). Text,
  /// not an enum: a value the producer adds is counted under its own name, not refused
  /// (docs/07 § 7.8).
  maintenanceType String   @map("maintenance_type") @db.VarChar(64)
  scheduleId      String?  @map("schedule_id") @db.VarChar(128)
  completedAt     DateTime @map("completed_at") @db.Timestamptz(3)
  /// How long the machine was unusable. Null when the producer did not know — never zero.
  downtimeMinutes Int?     @map("downtime_minutes")
  totalCostMinor  BigInt   @map("total_cost_minor")
  currency        String   @db.Char(3)
  /// The event the fact was made from: a second event for the same completion is compared
  /// with this row, never written over it.
  sourceEventId   String   @map("source_event_id") @db.VarChar(128)
  /// When the fact became visible here: the database clock at the insert, set by
  /// `tg_fact_maintenance_recorded_at` whatever a writer sends. A governance release decides
  /// membership and lateness by it (ADR-071 § 2 (8)).
  recordedAt      DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)

  @@id([organizationId, requestId])
  @@index([organizationId, completedAt], map: "ix_fact_maintenance_org_completed")
  @@map("fact_maintenance")
}

// ---------------------------------------------------------------------------
// Consumer idempotency (docs/07 § 7.5)
// ---------------------------------------------------------------------------

/// Which event each consumer has already applied, written in the same transaction as the
/// fact. Carries no organization: it is plumbing keyed by the event id, read only by the
/// consumer that wrote it.
model ProcessedEvent {
  eventId      String   @map("event_id") @db.VarChar(128)
  consumerName String   @map("consumer_name") @db.VarChar(128)
  processedAt  DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([eventId, consumerName])
  @@map("processed_event")
}

/// Append-only reference measurements (ADR-071 § 6, Q-142 (1)). No application writer or seed.
/// New versions are new rows; the latest recorded row for the exact key/scope/period is read.
model BaselineMetric {
  organizationId String   @map("organization_id") @db.VarChar(128)
  id             String   @db.VarChar(128)
  metricKey      String   @map("metric_key") @db.VarChar(64)
  scopeKind      String   @map("scope_kind") @db.VarChar(32)
  periodStart    DateTime @map("period_start") @db.Timestamptz(3)
  periodEnd      DateTime @map("period_end") @db.Timestamptz(3)
  value          BigInt
  unit           String   @db.VarChar(32)
  currency       String?  @db.Char(3)
  source         String   @db.VarChar(128)
  recordedBy     String   @map("recorded_by") @db.VarChar(128)
  recordedAt     DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)

  @@id([organizationId, id])
  @@index([organizationId, metricKey, scopeKind, periodStart, periodEnd, recordedAt(sort: Desc), id(sort: Desc)], map: "ix_baseline_metric_org_key_scope_period")
  @@map("baseline_metric")
}
