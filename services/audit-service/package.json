{
  "name": "@rasta/audit-service",
  "version": "0.1.0",
  "private": true,
  "description": "Bootstrap scaffold only. Append-only evidence ingestion (ADR-053) is not implemented: no schema, no consumer, no endpoint beyond the health probes.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist .turbo",
    "dev": "node --import @swc-node/register/esm-register --watch --env-file=../../.env src/main.ts",
    "start": "node --env-file=../../.env dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --selectProjects unit",
    "test:unit": "jest --selectProjects unit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@rasta/config": "workspace:*",
    "@rasta/logging": "workspace:*",
    "@rasta/nest-common": "workspace:*",
    "@rasta/observability": "workspace:*",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.10.7",
    "@swc/helpers": "^0.5.15",
    "@swc/jest": "^0.2.37",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.14",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "typescript": "^5.9.3"
  }
}
