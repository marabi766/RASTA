// audit-service — the platform's append-only evidence store (ADR-053).
//
// AUD-001 implements one of the two input paths the ADR defines: **path A, the
// domain projector**. A consumer group reads the ten currently produced domain
// topics and writes one `audit_event` per envelope, without asking any of the
// nine existing services to change.
//
// ## What path A structurally cannot give, and is therefore honestly empty
//
// The ADR is explicit that a projector row is incomplete by construction, and
// the emptiness must be visible in the data rather than hidden:
//
//   actorRoles   `[]` — an empty array, never null-as-unknown. A domain
//                envelope carries no roles.
//   sourceIp     null. Path B (AUD-004) supplies it from the request edge.
//   outcome      `SUCCESS`. A published domain event is a completed change; a
//                refusal never reaches a topic, which is exactly why path B
//                exists.
//   changes      null. A structured delta needs before/after values the
//                envelope does not carry.
//
// ## What AUD-003 added, and what it deliberately did not
//
// `recordHash` and `previousHash` (ADR § 6 layer 3) are **written** as of
// AUD-003, together with `AuditChainHead` below and
// `GET /v1/audit-events/verify`. Rows written before that migration keep both
// columns null and are never backfilled — a null there means "written before
// the chain existed", never "verified", and the verification endpoint reports
// such a range as `UNVERIFIABLE_LEGACY` rather than as valid.
//
// `correctionOf` (§ 7) is still declared and still **never written**. The ADR
// requires a correction to arrive through path B (`rasta.audit.trail.v1`), and
// path B is AUD-004: this service has no producer, no outbox and no write API,
// so there is no honest way to record one yet. The column stays inert rather
// than being filled by a shortcut that would make audit-service audit its own
// writes.
//
// `sequenceNo` is a `BIGSERIAL`, still meaningless across partitions. Within
// one chain it is now chain order, because the writer draws it while holding
// that chain's head lock. Read ordering for the query API is unchanged: by
// `occurredAt`, never `recordedAt` (ADR § 8).
//
// ## Ownership
//
// Everything here is owned by this service alone (AGENTS.md A-01). There is no
// foreign key into another service's database. `organizationId` is a plain
// external identifier whose authority is the envelope's `tenantId`;
// `organization_ref` is a local projection that exists only so later
// object-scoped querying (AUD-002) has something to join against, and it is
// never read from organization-service's database.

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuditActorType {
  USER
  SERVICE
  SYSTEM
  ANONYMOUS

  @@map("audit_actor_type")
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  REFUSED

  @@map("audit_outcome")
}

/// One piece of evidence that something happened.
///
/// Partitioned monthly by `occurredAt` (ADR § 11, `docs/05` § 5.6). Prisma
/// cannot express declarative partitioning, so the table is created by hand in
/// the migration and this model describes the shape Prisma reads and writes.
/// The `@@id` below is the partitioned table's real primary key —
/// `(occurred_at, id)` — because PostgreSQL requires the partition key in every
/// unique index on a partitioned table.
model AuditEvent {
  /// ULID, generated by this service. Not the source event id.
  id String @db.VarChar(64)

  /// When it happened in the domain — from `envelope.occurredAt`.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)

  /// When this row was written. Still the **database's** clock and never this
  /// process's: the gap between the two is consumer lag, and a value the
  /// application chose would measure nothing.
  ///
  /// Since AUD-003 the value is read as `now()` from inside the writing
  /// transaction and passed back in the same statement that writes the row,
  /// rather than being left to the column default. `now()` is
  /// `transaction_timestamp()`, so it is the identical value the default would
  /// have produced — read one statement earlier so the record hash can cover
  /// it. A timestamp the chain does not cover is a timestamp somebody can move
  /// without the chain noticing.
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  actorType AuditActorType @map("actor_type")
  actorId   String?        @map("actor_id") @db.VarChar(256)

  /// Empty array when unknown, never null. Path A always writes `[]`.
  actorRoles String[] @default([]) @map("actor_roles")

  /// Null only for a genuinely platform-scoped action.
  organizationId String? @map("organization_id") @db.VarChar(128)

  /// A dotted verb when ADR-053 defines one for the event name, otherwise the
  /// event name itself. An unknown name is stored, never dropped.
  action String @db.VarChar(256)

  resourceType String  @map("resource_type") @db.VarChar(128)
  resourceId   String? @map("resource_id") @db.VarChar(256)

  outcome   AuditOutcome
  errorCode String?      @map("error_code") @db.VarChar(128)
  reason    String?      @db.VarChar(1000)

  /// Structured, redacted delta. Path B only; always null in AUD-001.
  changes Json? @db.JsonB

  occurrenceCount Int @default(1) @map("occurrence_count")

  sourceService        String  @map("source_service") @db.VarChar(128)
  sourceServiceVersion String? @map("source_service_version") @db.VarChar(64)

  /// The idempotency key, together with the topic and the partition key.
  sourceEventId   String @map("source_event_id") @db.VarChar(128)
  sourceEventName String @map("source_event_name") @db.VarChar(128)
  /// The topic the message actually arrived on, from broker delivery metadata
  /// rather than from the envelope — a producer must not be able to assert it.
  sourceTopic     String @map("source_topic") @db.VarChar(256)

  sourceIp        String? @map("source_ip") @db.VarChar(64)
  sourceUserAgent String? @map("source_user_agent") @db.VarChar(512)

  correlationId String  @map("correlation_id") @db.VarChar(128)
  causationId   String? @map("causation_id") @db.VarChar(128)
  traceparent   String? @db.VarChar(256)

  /// ADR-051 stream position when the producer sent one. Stored for detection
  /// only: nothing blocks, buffers or reorders on it, and an envelope without
  /// it is processed normally.
  sourceStreamSeq BigInt? @map("source_stream_seq")

  /// The SHA-256 link, written since AUD-003 (ADR-053 § 6 layer 3).
  ///
  /// `recordHash` is `SHA256(canonical(row without these two columns) ||
  /// previousHash)`; `previousHash` is the `recordHash` of the record before
  /// this one in the same `(organizationId, UTC month)` chain, and is null on
  /// the record that starts a chain segment.
  ///
  /// **Null on both means the row predates AUD-003, not that it verified.**
  /// Nothing backfills them: computing a chain over rows nobody chained at the
  /// time and then calling the result evidence is the one operation this store
  /// must never perform. The verification endpoint reports such a row as an
  /// explicit `UNVERIFIABLE_LEGACY` boundary.
  recordHash   Bytes? @map("record_hash")
  previousHash Bytes? @map("previous_hash")

  /// Chain order within one partition, and the verification walk's sort key.
  ///
  /// Still a `BIGSERIAL`, and still meaningless across partitions. What changed
  /// in AUD-003 is *when* the value is drawn: the writer allocates it from the
  /// sequence while holding the chain head's row lock, so within one chain,
  /// allocation order and chain order are the same order by construction. The
  /// application supplies the value explicitly for that reason, and because a
  /// value the hash does not cover is a value somebody can change unnoticed.
  sequenceNo BigInt @default(autoincrement()) @map("sequence_no")

  /// Reserved for AUD-007 corrections. Never written by AUD-001.
  correctionOf String? @map("correction_of") @db.VarChar(64)

  /// The partition key must be part of every unique index, so identity is
  /// `(occurred_at, id)` rather than `id` alone.
  @@id([occurredAt, id])
  /// ADR § 8: one row per delivered source event per topic.
  @@unique([occurredAt, sourceEventId, sourceTopic], map: "audit_event_source_identity_key")
  @@index([organizationId, occurredAt(sort: Desc)], map: "audit_event_org_time_idx")
  @@index([occurredAt(sort: Desc)], map: "audit_event_time_idx")
  @@index([resourceType, resourceId, occurredAt(sort: Desc)], map: "audit_event_resource_idx")
  @@index([correlationId], map: "audit_event_correlation_idx")
  @@index([sourceTopic, occurredAt(sort: Desc)], map: "audit_event_topic_time_idx")
  /// The chain-order access path: one tenant's rows inside one month
  /// partition, in the order the chain was built (AUD-003).
  @@index([organizationId, sequenceNo], map: "audit_event_chain_idx")
  @@map("audit_event")
}

/// Consumer-side idempotency (AGENTS.md A-09, `docs/07` § 7.5).
///
/// Written in the same transaction as the audit row, so an event is never
/// marked processed without the evidence it was processed for.
model ProcessedEvent {
  eventId      String   @map("event_id") @db.VarChar(128)
  consumerName String   @map("consumer_name") @db.VarChar(128)
  processedAt  DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, consumerName])
  @@map("processed_event")
}

/// How much this service knows about one organization's place in the hierarchy.
enum OrganizationRelationState {
  /// Seen only as the tenant of an audit event. The identifier is real; its
  /// parent is unknown. Never a subtree member and never a subtree root.
  UNKNOWN
  /// Described by an `ORGANIZATION_CREATED` or `ORGANIZATION_MOVED` event, so
  /// the parent link on this row came from the service that owns it.
  PROJECTED

  @@map("organization_relation_state")
}

/// The local hierarchy projection `UNION_ADMIN` scoping is decided from.
///
/// A projection, not a replica: it holds identifiers and the parent link the
/// owning service published, never organization-service's rows, and it is never
/// read from that service's database (AGENTS.md A-01, A-02).
///
/// ## Adjacency is the authority; the path is a note
///
/// `ORGANIZATION_MOVED` rewrites the path of every descendant upstream but is
/// published once, for the organization that moved. Authorising from
/// `hierarchyPath` would therefore leave every descendant's stored path wrong
/// after the first move, in the broadening direction ADR-053 § 10 forbids. A
/// descendant's **parent** does not change when its ancestor moves, so
/// `parentOrganizationId` is what the subtree check walks, and `hierarchyPath`
/// and `hierarchyDepth` are diagnostics that no authorization decision reads.
///
/// ## `relationState` is the fail-closed switch
///
/// The projector upserts a row here for the tenant of every audit event. Such a
/// row is a bare identifier with a null parent, and must never be mistaken for
/// a hierarchy root. Only `PROJECTED` rows take part in a subtree decision;
/// `UNKNOWN` ones are invisible to it, so an organization this service has
/// never seen an organization event for can only ever produce a **missing**
/// result, never an extra one.
model OrganizationRef {
  organizationId String   @id @map("organization_id") @db.VarChar(128)
  firstSeenAt    DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt     DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  /// From `ORGANIZATION_CREATED.parentId` and `ORGANIZATION_MOVED.newParentId`.
  /// Null on a genuine hierarchy root — and also on every `UNKNOWN` row, which
  /// is why `relationState` and not this column decides membership.
  parentOrganizationId String? @map("parent_organization_id") @db.VarChar(128)

  /// Last observed materialised path. Diagnostics only: goes stale for every
  /// descendant of a moved organization and is never read by an authorization
  /// decision.
  hierarchyPath String? @map("hierarchy_path") @db.VarChar(2048)

  /// Depth as the owning service reported it at the time. Diagnostics only,
  /// for the same reason as `hierarchyPath`.
  hierarchyDepth Int? @map("hierarchy_depth")

  /// From `ORGANIZATION_CREATED.status` and
  /// `ORGANIZATION_STATUS_CHANGED.newStatus`. A free string rather than an enum
  /// because the value belongs to another service's vocabulary and this one
  /// must not fail to record a status it has not heard of.
  status String? @map("status") @db.VarChar(64)

  relationState OrganizationRelationState @default(UNKNOWN) @map("relation_state")

  /// `occurredAt` of the newest organization event applied to this row. Makes
  /// the projection monotonic: an older event replayed after a newer one is
  /// ignored rather than winding the hierarchy back.
  relationObservedAt DateTime? @map("relation_observed_at") @db.Timestamptz(6)

  @@index([lastSeenAt(sort: Desc)], map: "organization_ref_last_seen_idx")
  @@index([parentOrganizationId], map: "organization_ref_parent_idx")
  @@index([relationState], map: "organization_ref_relation_state_idx")
  @@map("organization_ref")
}

/// Which chain family a head belongs to (AUD-003, ADR-053 § 6).
enum AuditChainScope {
  /// One tenant's month. `organizationId` is that tenant's identifier.
  ORGANIZATION
  /// The platform's own month — the rows whose `organizationId` is null.
  /// `organizationId` here is the empty string, which no tenant can hold.
  PLATFORM

  @@map("audit_chain_scope")
}

/// The tip of one `(organization, UTC month)` hash chain.
///
/// ## Why a table and not `max(sequenceNo)` over the evidence
///
/// The next record has to be linked to the current tip *before* it exists, and
/// two concurrent writers must not both read the same tip. An aggregate over
/// `AuditEvent` locks nothing, so both would read the same value and write two
/// records claiming the same predecessor — a forked chain, produced silently
/// under exactly the load the store matters most under. One head row per chain,
/// taken with `SELECT … FOR UPDATE` inside the writing transaction, is what
/// makes the assignment atomic (`AuditRepository.ingest`).
///
/// ## The key, and the platform chain that must not collide with a tenant
///
/// `organizationId` on `AuditEvent` is nullable for genuinely platform-scoped
/// actions, and a nullable column can be neither a primary key nor an
/// unambiguous unique key — PostgreSQL treats two nulls as distinct, so keying
/// on it directly would permit two platform heads for the same month, which is
/// a fork by construction. So the key carries an explicit `chainScope`
/// discriminator and a non-null `organizationId` whose value on the platform
/// chain is the empty string. A blank organization identifier is refused by
/// `audit_event_organization_id_not_blank` and by
/// `audit_chain_head_scope_shape`, so the marker can never be a real tenant.
///
/// ## This table is a pointer, not evidence
///
/// It is the only object in this service the runtime role may `UPDATE`, and
/// that is precisely why it is separate from `AuditEvent`: the evidence keeps
/// its "no UPDATE at all" grant untouched. A database trigger refuses `DELETE`
/// and `TRUNCATE` outright and refuses any `UPDATE` that does not advance
/// `chainLength` by exactly one, so a head cannot be rewound to make the next
/// legitimate insert re-link onto an older tip.
model AuditChainHead {
  chainScope     AuditChainScope @map("chain_scope")
  organizationId String          @map("organization_id") @db.VarChar(128)

  /// Always the first day of a UTC month.
  chainMonth DateTime @map("chain_month") @db.Date

  /// Zero means "this chain exists and is empty" — a real state, because the
  /// first writer creates the row before it knows its own hash so that the lock
  /// it needs has something to lock.
  chainLength BigInt @default(0) @map("chain_length")

  /// The `recordHash` of the newest record in this chain. SHA-256, so 32 bytes.
  headHash       Bytes?    @map("head_hash")
  headEventId    String?   @map("head_event_id") @db.VarChar(64)
  headOccurredAt DateTime? @map("head_occurred_at") @db.Timestamptz(6)
  headSequenceNo BigInt?   @map("head_sequence_no")

  /// Where this chain's verifiable segment begins — the `sequenceNo` of the
  /// first record ever linked into it.
  ///
  /// Written once, on the `chainLength` 0 → 1 transition, and immutable
  /// afterwards; the database trigger refuses any other value, so this is a
  /// structural fact rather than an application convention.
  ///
  /// It exists because a null `recordHash` means two opposite things. A row
  /// written before AUD-003 was never chained and is honestly unverifiable; a
  /// row written after it whose link was stripped is integrity damage. Every
  /// pre-migration row drew a lower `sequenceNo` than any post-migration one,
  /// so "below the segment start" is provably "written before this chain was
  /// chained". Verification reads a null hash below this value as
  /// `UNVERIFIABLE_LEGACY` and a null hash at or above it as `DIVERGENT`.
  firstSequenceNo BigInt? @map("first_sequence_no")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([chainScope, organizationId, chainMonth])
  @@index([chainMonth, chainScope], map: "audit_chain_head_month_idx")
  @@map("audit_chain_head")
}
