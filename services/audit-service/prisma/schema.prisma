// audit-service — the platform's append-only evidence store (ADR-053).
//
// AUD-001 implements one of the two input paths the ADR defines: **path A, the
// domain projector**. A consumer group reads the ten currently produced domain
// topics and writes one `audit_event` per envelope, without asking any of the
// nine existing services to change.
//
// ## What path A structurally cannot give, and is therefore honestly empty
//
// The ADR is explicit that a projector row is incomplete by construction, and
// the emptiness must be visible in the data rather than hidden:
//
//   actorRoles   `[]` — an empty array, never null-as-unknown. A domain
//                envelope carries no roles.
//   sourceIp     null. Path B (AUD-004) supplies it from the request edge.
//   outcome      `SUCCESS`. A published domain event is a completed change; a
//                refusal never reaches a topic, which is exactly why path B
//                exists.
//   changes      null. A structured delta needs before/after values the
//                envelope does not carry.
//
// ## Columns present but inert in AUD-001
//
// `recordHash`, `previousHash` (ADR § 6 layer 3) and `correctionOf` (§ 7) are
// declared because the ADR requires schema compatibility for the later phases,
// and adding a column to a partitioned table with eighteen partitions is a
// migration nobody wants to run twice. **They are never written by AUD-001 and
// no hash behaviour is claimed.** A reader must not mistake a null
// `recordHash` for a verified one — AUD-003 fills them and brings the
// verification endpoint that makes them mean anything. Until then the chain is
// absent, not broken.
//
// `sequenceNo` is a per-partition `BIGSERIAL`, which is monotonic within a
// partition and says nothing about global order. Read ordering is by
// `occurredAt`, never `recordedAt` (ADR § 8).
//
// ## Ownership
//
// Everything here is owned by this service alone (AGENTS.md A-01). There is no
// foreign key into another service's database. `organizationId` is a plain
// external identifier whose authority is the envelope's `tenantId`;
// `organization_ref` is a local projection that exists only so later
// object-scoped querying (AUD-002) has something to join against, and it is
// never read from organization-service's database.

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuditActorType {
  USER
  SERVICE
  SYSTEM
  ANONYMOUS

  @@map("audit_actor_type")
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  REFUSED

  @@map("audit_outcome")
}

/// One piece of evidence that something happened.
///
/// Partitioned monthly by `occurredAt` (ADR § 11, `docs/05` § 5.6). Prisma
/// cannot express declarative partitioning, so the table is created by hand in
/// the migration and this model describes the shape Prisma reads and writes.
/// The `@@id` below is the partitioned table's real primary key —
/// `(occurred_at, id)` — because PostgreSQL requires the partition key in every
/// unique index on a partitioned table.
model AuditEvent {
  /// ULID, generated by this service. Not the source event id.
  id String @db.VarChar(64)

  /// When it happened in the domain — from `envelope.occurredAt`.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)

  /// When this row was written. Database-generated, never supplied by the
  /// application: the gap between the two is consumer lag, and a value the
  /// application chose would measure nothing.
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  actorType AuditActorType @map("actor_type")
  actorId   String?        @map("actor_id") @db.VarChar(256)

  /// Empty array when unknown, never null. Path A always writes `[]`.
  actorRoles String[] @default([]) @map("actor_roles")

  /// Null only for a genuinely platform-scoped action.
  organizationId String? @map("organization_id") @db.VarChar(128)

  /// A dotted verb when ADR-053 defines one for the event name, otherwise the
  /// event name itself. An unknown name is stored, never dropped.
  action String @db.VarChar(256)

  resourceType String  @map("resource_type") @db.VarChar(128)
  resourceId   String? @map("resource_id") @db.VarChar(256)

  outcome   AuditOutcome
  errorCode String?      @map("error_code") @db.VarChar(128)
  reason    String?      @db.VarChar(1000)

  /// Structured, redacted delta. Path B only; always null in AUD-001.
  changes Json? @db.JsonB

  occurrenceCount Int @default(1) @map("occurrence_count")

  sourceService        String  @map("source_service") @db.VarChar(128)
  sourceServiceVersion String? @map("source_service_version") @db.VarChar(64)

  /// The idempotency key, together with the topic and the partition key.
  sourceEventId   String @map("source_event_id") @db.VarChar(128)
  sourceEventName String @map("source_event_name") @db.VarChar(128)
  /// The topic the message actually arrived on, from broker delivery metadata
  /// rather than from the envelope — a producer must not be able to assert it.
  sourceTopic String @map("source_topic") @db.VarChar(256)

  sourceIp        String? @map("source_ip") @db.VarChar(64)
  sourceUserAgent String? @map("source_user_agent") @db.VarChar(512)

  correlationId String  @map("correlation_id") @db.VarChar(128)
  causationId   String? @map("causation_id") @db.VarChar(128)
  traceparent   String? @db.VarChar(256)

  /// ADR-051 stream position when the producer sent one. Stored for detection
  /// only: nothing blocks, buffers or reorders on it, and an envelope without
  /// it is processed normally.
  sourceStreamSeq BigInt? @map("source_stream_seq")

  /// Reserved for AUD-003. Never written by AUD-001 — see the header.
  recordHash   Bytes? @map("record_hash")
  previousHash Bytes? @map("previous_hash")

  /// Monotonic within a partition only.
  sequenceNo BigInt @default(autoincrement()) @map("sequence_no")

  /// Reserved for AUD-007 corrections. Never written by AUD-001.
  correctionOf String? @map("correction_of") @db.VarChar(64)

  /// The partition key must be part of every unique index, so identity is
  /// `(occurred_at, id)` rather than `id` alone.
  @@id([occurredAt, id])
  /// ADR § 8: one row per delivered source event per topic.
  @@unique([occurredAt, sourceEventId, sourceTopic], map: "audit_event_source_identity_key")
  @@index([organizationId, occurredAt(sort: Desc)], map: "audit_event_org_time_idx")
  @@index([occurredAt(sort: Desc)], map: "audit_event_time_idx")
  @@index([resourceType, resourceId, occurredAt(sort: Desc)], map: "audit_event_resource_idx")
  @@index([correlationId], map: "audit_event_correlation_idx")
  @@index([sourceTopic, occurredAt(sort: Desc)], map: "audit_event_topic_time_idx")
  @@map("audit_event")
}

/// Consumer-side idempotency (AGENTS.md A-09, `docs/07` § 7.5).
///
/// Written in the same transaction as the audit row, so an event is never
/// marked processed without the evidence it was processed for.
model ProcessedEvent {
  eventId      String   @map("event_id") @db.VarChar(128)
  consumerName String   @map("consumer_name") @db.VarChar(128)
  processedAt  DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, consumerName])
  @@map("processed_event")
}

/// A local note of which organizations have been seen.
///
/// Exists only so AUD-002's object-scoped queries have something to filter and
/// display against without a cross-service call on the read path. It is a
/// projection, not a replica: it holds an identifier and the window it was
/// observed in, never organization-service's rows (AGENTS.md A-01, A-02).
model OrganizationRef {
  organizationId String   @id @map("organization_id") @db.VarChar(128)
  firstSeenAt    DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt     DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  @@index([lastSeenAt(sort: Desc)], map: "organization_ref_last_seen_idx")
  @@map("organization_ref")
}
