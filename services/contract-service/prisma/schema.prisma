// contract-service — the contract boundary (CON-003, ADR-068, docs/04 § 4.13).
// It holds the draft contract a tender award creates, and — since PR 2 — its signatures
// and its cancellation, and — since PR 3 — the amendments and planned milestones of a signed
// contract; statements, the separate technical and financial approvals and the settlement
// boundary are later changes (ADR-068 § 9).
//
// Everything here is owned by this service alone (AGENTS.md A-01). There is no
// foreign key into another service's database: `organizationId` (the employer),
// `tenderId`, `projectId`, `winningBidId` and `contractorOrganizationId` are plain
// external identifiers whose authority is the owner of each.
//
// ## Money never lives here as a number of anything but minor units
//
// `amount_minor` is a bigint of rial minor units (AGENTS.md § 3), read from the
// owner of the award — never from an event (`TENDER_AWARDED` carries no amount).
// This service holds no wallet, no ledger entry and no balance (ADR-068 § 6).
//
// ## Tenant isolation is in the keys, not only in the guard
//
// `organization_id` — the employer's, the tenant of the contract — leads every
// index but one. The exception is the contractor's own view (`ix_contract_contractor`):
// the winning contractor reads its contract across the tenant boundary, with its own
// organization in the predicate (ADR-068 § 7), so that index leads with it.
//
// Every instant is `timestamptz(3)` from the first migration (D-048): raw SQL
// (`now()`, a default, a trigger) can never store a session's wall clock here.

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Contract
// ---------------------------------------------------------------------------

/// The contract lifecycle (`src/contract/contract.state-machine.ts`, ADR-068 § 2).
/// The whole lifecycle is declared now (adding a value to a PostgreSQL enum cannot
/// be reversed); this change reaches DRAFT only.
enum ContractStatus {
  DRAFT
  SIGNED
  COMPLETED
  SETTLED
  CANCELLED
}

/// A contract — the aggregate root of this service (docs/03 § 3.3). One per awarded
/// tender, made from `TENDER_AWARDED` by the consumer (ADR-068 § 3) and by nothing
/// else: no user creates a contract (Q-95 (3)).
model Contract {
  id String @id

  /// The employer: the tender's owner, the tenant of the contract.
  organizationId String @map("organization_id")

  tenderId                 String @map("tender_id")
  projectId                String @map("project_id")
  winningBidId             String @map("winning_bid_id")
  /// The winning contractor. Read across the tenant boundary with its own
  /// organization in the predicate, and nowhere else.
  contractorOrganizationId String @map("contractor_organization_id")

  /// The winner's price in rial minor units, as the owner of the award states it
  /// (Q-95 (5): the award's amount, with no adjustment).
  amountMinor BigInt @map("amount_minor")

  /// SHA-256 (hex) of the frozen evaluation matrix the award was made against, as the
  /// owner of the award states it: ties the draft to the decision it came from.
  matrixDigest String @map("matrix_digest")

  /// Who awarded and when, as the owner of the award states it.
  awardedBy String   @map("awarded_by")
  awardedAt DateTime @map("awarded_at") @db.Timestamptz(3)

  status          ContractStatus @default(DRAFT)
  statusChangedAt DateTime       @map("status_changed_at") @db.Timestamptz(3)
  statusChangedBy String         @map("status_changed_by")

  /// The `TENDER_AWARDED` event this draft was made from (causation).
  sourceEventId String @map("source_event_id")

  createdAt            DateTime @map("created_at") @db.Timestamptz(3)
  createdBy            String   @map("created_by")
  createdCorrelationId String   @map("created_correlation_id")
  updatedAt            DateTime @map("updated_at") @db.Timestamptz(3)

  /// Why the employer cancelled the draft (CON-003 PR 2, Q-95 (4)): a closed code the
  /// configuration owns, and an optional bounded note. Set with the transition to
  /// CANCELLED and nowhere else (`ck_contract_cancellation`).
  cancelReasonCode String? @map("cancel_reason_code")
  cancelNote       String? @map("cancel_note")

  /// The two counters of the ADR-068 § 5 cap invariant, `approved_total_minor <= amount_minor +
  /// amendments_total_minor` (`ck_contract_approved_cap`). CON-003 PR 3 moves only the first, under
  /// the contract's row lock, when an amendment becomes effective, and only to the exact sum of the
  /// effective deltas (`contract_guard`); the second is PR 4's and stays 0 here.
  amendmentsTotalMinor BigInt @default(0) @map("amendments_total_minor")
  approvedTotalMinor   BigInt @default(0) @map("approved_total_minor")

  /// The compare-and-set token. Every change matches on it and increments it.
  version Int @default(1)

  signatures          ContractSignature[]
  amendments          Amendment[]
  amendmentSignatures AmendmentSignature[]
  milestones          Milestone[]

  // The idempotency key of the consumer: one contract per awarded tender.
  @@unique([organizationId, tenderId], map: "ux_contract_org_tender")
  // The composite target of every later child's tenant-bound foreign key, and the
  // index every tenant-scoped id lookup uses.
  @@unique([organizationId, id], map: "ux_contract_org_id")
  @@index([organizationId, status, id], map: "ix_contract_org_status")
  // The contractor's own contracts (ADR-068 § 7): not led by organization_id, on purpose.
  @@index([contractorOrganizationId, id], map: "ix_contract_contractor")
  @@map("contract")
}

enum ContractSide {
  EMPLOYER
  CONTRACTOR
}

/// One side's acceptance of a draft contract (CON-003 PR 2, ADR-068 § 2, Q-95 (1)):
/// the audit record of a signature — who accepted for which party, when, and under which
/// configured authority. A recorded acceptance, not a legal signature. Written once; the
/// database refuses to change or remove it, to sign a contract that is no longer a draft,
/// to sign for a side as an organization that is not that side, and one person on both sides.
///
/// `organizationId` is the contract's tenant — the employer's — for both sides: the
/// contractor's signature is written across the tenant boundary on purpose, naming the
/// contract's organization explicitly (ContractRepository.insertSignature).
model ContractSignature {
  id             String @id
  organizationId String @map("organization_id")
  contractId     String @map("contract_id")

  side                 ContractSide
  /// The organization the signer acted for (the signed token's).
  signerOrganizationId String       @map("signer_organization_id")

  /// The person: platform user id, and the token's verified issuer and subject — both or
  /// neither — so a later separation-of-duties check compares a stable identity (#188).
  signedBy        String  @map("signed_by")
  signedByIssuer  String? @map("signed_by_issuer")
  signedBySubject String? @map("signed_by_subject")

  /// The role the signature was accepted under: the role the employer's policy names for the
  /// employer's side, `CONTRACTOR` for the contractor's.
  authorityRole String   @map("authority_role")
  signedAt      DateTime @map("signed_at") @db.Timestamptz(3)
  correlationId String   @map("correlation_id")

  /// The `contract.signature` policy that authorised the employer's side — its id and version —
  /// and nothing for the contractor's (`ck_signature_policy`).
  policyId      String? @map("policy_id")
  policyVersion Int?    @map("policy_version")

  /// The hierarchy evidence an employer signature under a union-written policy rested on (D-050):
  /// the author organization asked about, the answer (always WITHIN — any other refused the
  /// signature), when it arrived, and the latest instant the signature could have committed. All
  /// four or none (`ck_signature_hierarchy_evidence`); none for the contractor's side and for a
  /// platform-written policy, which needs no hierarchy.
  hierarchyAuthorOrganizationId String?   @map("hierarchy_author_organization_id")
  hierarchyAnswer               String?   @map("hierarchy_answer")
  hierarchyReadAt               DateTime? @map("hierarchy_read_at") @db.Timestamptz(3)
  hierarchyCommitDeadline       DateTime? @map("hierarchy_commit_deadline") @db.Timestamptz(3)
  /// The employer's hierarchy version in the tree that answer came from (organization-service's
  /// number, stamped in the move's own transaction): what a later ORGANIZATION_MOVED is ordered
  /// against, by number, not by clock. NULL on a signature from before versions and where there is
  /// no evidence (`ck_signature_hierarchy_version`).
  hierarchyVersion              BigInt?   @map("hierarchy_version")

  contract Contract                  @relation(fields: [organizationId, contractId], references: [organizationId, id])
  policy   ApprovalPolicy?           @relation(fields: [organizationId, policyId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  review   SignatureAuthorityReview?

  @@unique([organizationId, contractId, side], map: "ux_contract_signature_side")
  @@map("contract_signature")
}

/// A signature a move may have raced (D-050): flagged, never revoked. Written once by the
/// reconciliation of an ORGANIZATION_MOVED that stranded the policy the signature rests on, and
/// never changed (`tg_signature_authority_review_immutable`).
model SignatureAuthorityReview {
  id              String       @id
  organizationId  String       @map("organization_id")
  contractId      String       @map("contract_id")
  side            ContractSide
  policyId        String       @map("policy_id")
  /// `AUTHORITY_CHANGED_DURING_SIGNING` (the only one so far).
  reason          String
  /// The move proven to be the cause, with its instant — or neither (`detectedBy` = MOVE_RECHECK).
  causeEventId    String?      @map("cause_event_id")
  movedAt         DateTime?    @map("moved_at") @db.Timestamptz(3)
  /// `ORGANIZATION_MOVED` (a proven cause) or `MOVE_RECHECK` (a move queued the re-check; not shown to be its cause).
  detectedBy      String       @map("detected_by")
  /// What was compared: the move's hierarchy version and the one the signature recorded (NULL for
  /// a move or signature from before versions).
  movedVersion    BigInt?      @map("moved_version")
  recordedVersion BigInt?      @map("recorded_version")
  flaggedAt       DateTime     @map("flagged_at") @db.Timestamptz(3)

  signature ContractSignature @relation(fields: [organizationId, contractId, side], references: [organizationId, contractId, side], onDelete: Restrict, onUpdate: Restrict)
  policy    ApprovalPolicy    @relation(fields: [organizationId, policyId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, contractId, side], map: "ux_signature_authority_review_signature")
  @@map("signature_authority_review")
}

// ---------------------------------------------------------------------------
// Amendments and milestones (CON-003 PR 3, ADR-068 § 9, docs/24 Q-100)
// ---------------------------------------------------------------------------

/// `src/amendment/amendment.state-machine.ts`: PROPOSED → EFFECTIVE, and nothing else.
enum AmendmentStatus {
  PROPOSED
  EFFECTIVE
}

/// A change to the price of a SIGNED contract, proposed by the employer and effective only when
/// both parties have signed it. The delta is a bigint of minor units and strictly positive for now
/// (`ck_amendment_delta_positive`; Q-100 asks whether a reduction exists). What it says never
/// changes once proposed; once effective nothing about it does, and it is never deleted.
model Amendment {
  id             String @id
  organizationId String @map("organization_id")
  contractId     String @map("contract_id")

  /// 1, 2, 3 … per contract, taken under the contract's row lock.
  amendmentNumber Int    @map("amendment_number")
  deltaMinor      BigInt @map("delta_minor")
  /// A code of the closed list the configuration owns, and a bounded bidi-safe text.
  reasonCode      String @map("reason_code")
  reasonText      String @map("reason_text")

  status AmendmentStatus @default(PROPOSED)

  proposedBy            String    @map("proposed_by")
  proposedAt            DateTime  @map("proposed_at") @db.Timestamptz(3)
  proposedCorrelationId String    @map("proposed_correlation_id")
  /// Set with the transition to EFFECTIVE, and only then (`ck_amendment_effective`).
  effectiveAt           DateTime? @map("effective_at") @db.Timestamptz(3)
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(3)

  /// The compare-and-set token: moves with the status, not with a signature.
  version Int @default(1)

  contract   Contract             @relation(fields: [organizationId, contractId], references: [organizationId, id])
  signatures AmendmentSignature[]

  @@unique([organizationId, id], map: "ux_amendment_org_id")
  @@unique([organizationId, contractId, amendmentNumber], map: "ux_amendment_number")
  @@map("amendment")
}

/// One side's signature of an amendment: the same record as `ContractSignature` — who accepted for
/// which party, under which configured authority and which hierarchy version. Written once.
model AmendmentSignature {
  id             String @id
  organizationId String @map("organization_id")
  contractId     String @map("contract_id")
  amendmentId    String @map("amendment_id")

  side                 ContractSide
  signerOrganizationId String       @map("signer_organization_id")

  signedBy        String  @map("signed_by")
  signedByIssuer  String? @map("signed_by_issuer")
  signedBySubject String? @map("signed_by_subject")

  authorityRole String   @map("authority_role")
  signedAt      DateTime @map("signed_at") @db.Timestamptz(3)
  correlationId String   @map("correlation_id")

  /// The `contract.signature` policy that authorised the employer's side; nothing for the contractor's.
  policyId      String? @map("policy_id")
  policyVersion Int?    @map("policy_version")

  hierarchyAuthorOrganizationId String?   @map("hierarchy_author_organization_id")
  hierarchyAnswer               String?   @map("hierarchy_answer")
  hierarchyReadAt               DateTime? @map("hierarchy_read_at") @db.Timestamptz(3)
  hierarchyCommitDeadline       DateTime? @map("hierarchy_commit_deadline") @db.Timestamptz(3)
  hierarchyVersion              BigInt?   @map("hierarchy_version")

  contract  Contract                  @relation(fields: [organizationId, contractId], references: [organizationId, id])
  amendment Amendment                 @relation(fields: [organizationId, amendmentId], references: [organizationId, id])
  policy    ApprovalPolicy?           @relation(fields: [organizationId, policyId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  review    AmendmentSignatureReview?

  @@unique([organizationId, amendmentId, side], map: "ux_amendment_signature_side")
  @@index([organizationId, policyId], map: "ix_amendment_signature_policy")
  @@map("amendment_signature")
}

/// An employer amendment signature a move may have raced (D-050): flagged, never revoked.
model AmendmentSignatureReview {
  id              String       @id
  organizationId  String       @map("organization_id")
  contractId      String       @map("contract_id")
  amendmentId     String       @map("amendment_id")
  side            ContractSide
  policyId        String       @map("policy_id")
  /// `AUTHORITY_CHANGED_DURING_SIGNING` (the only one so far).
  reason          String
  /// The move proven to be the cause, with its instant — or neither (`detectedBy` = MOVE_RECHECK).
  causeEventId    String?      @map("cause_event_id")
  movedAt         DateTime?    @map("moved_at") @db.Timestamptz(3)
  detectedBy      String       @map("detected_by")
  movedVersion    BigInt?      @map("moved_version")
  recordedVersion BigInt?      @map("recorded_version")
  flaggedAt       DateTime     @map("flagged_at") @db.Timestamptz(3)

  signature AmendmentSignature @relation(fields: [organizationId, amendmentId, side], references: [organizationId, amendmentId, side], onDelete: Restrict, onUpdate: Restrict, map: "amendment_signature_review_signature_fkey")
  policy    ApprovalPolicy     @relation(fields: [organizationId, policyId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "amendment_signature_review_policy_fkey")

  @@unique([organizationId, amendmentId, side], map: "ux_amendment_signature_review_signature")
  @@index([organizationId, policyId], map: "ix_amendment_signature_review_policy")
  @@map("amendment_signature_review")
}

/// A planned milestone of a SIGNED contract: a title, a planned DATE (a day, never an instant) and
/// an optional planned share in basis points. Edited by the employer while no statement refers to
/// it; `firstReferencedAt` is set by the statement change of PR 4 (never by PR 3) and freezes it.
model Milestone {
  id             String @id
  organizationId String @map("organization_id")
  contractId     String @map("contract_id")

  title          String
  plannedDate    DateTime @map("planned_date") @db.Date
  /// 1 to 10000 when given. No sum across a contract's milestones is kept: no document defines one.
  plannedShareBp Int?     @map("planned_share_bp")

  createdAt            DateTime  @map("created_at") @db.Timestamptz(3)
  createdBy            String    @map("created_by")
  createdCorrelationId String    @map("created_correlation_id")
  updatedAt            DateTime  @map("updated_at") @db.Timestamptz(3)
  updatedBy            String    @map("updated_by")
  /// The first statement that referred to it; once set, the milestone never changes.
  firstReferencedAt    DateTime? @map("first_referenced_at") @db.Timestamptz(3)

  version Int @default(1)

  contract Contract @relation(fields: [organizationId, contractId], references: [organizationId, id])

  @@unique([organizationId, id], map: "ux_milestone_org_id")
  @@index([organizationId, contractId, plannedDate, id], map: "ix_milestone_contract")
  @@map("milestone")
}

// ---------------------------------------------------------------------------
// Approval policy — configuration as data (ADR-068 § 5, ADR-063, ADR-023, Q-70, Q-95)
// ---------------------------------------------------------------------------

enum ApprovalPolicyStatus {
  DRAFT
  PENDING_PLATFORM_APPROVAL
  ACTIVE
  REJECTED
  RETIRED
  /// Taken out of force by the system because the union that wrote it no longer governs the
  /// organization it was written for (Q-83). Never revived: a new version replaces it.
  SUSPENDED
}

/// Who may do what to a contract, as rows written by the people entitled to write them, never by
/// code or environment: the platform stores the authority it is told and creates none (ADR-023).
/// `contract.signature` is the one workflow so far — which roles of the employer's organization
/// accept a contract for it. A policy is immutable once written (the database keeps it so): a
/// change is a new version, put in force in place of the old one, so what a signature recorded
/// stays true.
model ApprovalPolicy {
  id String @id

  /// The organization this policy governs (the employer whose contracts it applies to).
  organizationId       String @map("organization_id")
  /// The organization whose administrator wrote it: the governed organization's union or an
  /// ancestor union, or the platform (Q-70 (7), decided).
  authorOrganizationId String @map("author_organization_id")
  /// `UNION_ADMIN` or `SYSTEM_ADMIN` (`ck_policy_author_role`).
  authorRole           String @map("author_role")

  /// `contract.signature` (`ck_policy_workflow_key`).
  workflowKey   String @map("workflow_key")
  /// 1, 2, 3 … per (organization, workflow key).
  policyVersion Int    @map("policy_version")

  status    ApprovalPolicyStatus @default(DRAFT)
  label     String
  /// Why this policy — a governance setting without a rationale is unauditable.
  rationale String
  /// Demo data labelled «نمونه — نیازمند تصویب» (ADR-023).
  isSample  Boolean              @default(false) @map("is_sample")

  createdAt            DateTime  @map("created_at") @db.Timestamptz(3)
  createdBy            String    @map("created_by")
  /// The author's and the submitter's stable identity (#188): the token's issuer and subject,
  /// both or neither. NULL is unknown, which the four-eyes check treats as the approver's own work.
  createdByIssuer      String?   @map("created_by_issuer")
  createdBySubject     String?   @map("created_by_subject")
  createdCorrelationId String    @map("created_correlation_id")
  submittedAt          DateTime? @map("submitted_at") @db.Timestamptz(3)
  submittedBy          String?   @map("submitted_by")
  submittedByIssuer    String?   @map("submitted_by_issuer")
  submittedBySubject   String?   @map("submitted_by_subject")
  /// The platform approval: the SYSTEM_ADMIN who approved it, and when.
  activatedAt          DateTime? @map("activated_at") @db.Timestamptz(3)
  activatedBy          String?   @map("activated_by")
  rejectedAt           DateTime? @map("rejected_at") @db.Timestamptz(3)
  rejectedBy           String?   @map("rejected_by")
  rejectionReason      String?   @map("rejection_reason")
  retiredAt            DateTime? @map("retired_at") @db.Timestamptz(3)
  retiredBy            String?   @map("retired_by")
  /// The system suspended it (ORGANIZATION_MOVED, Q-83): when, by whom (`system:contract-service`),
  /// and a closed-code reason. All three or none, exactly when the status is SUSPENDED.
  suspendedAt          DateTime? @map("suspended_at") @db.Timestamptz(3)
  suspendedBy          String?   @map("suspended_by")
  suspensionReason     String?   @map("suspension_reason")

  version Int @default(1)

  steps               ApprovalPolicyStep[]
  signatures          ContractSignature[]
  amendmentSignatures AmendmentSignature[]
  amendmentReviews    AmendmentSignatureReview[]
  reconciliationTasks PolicyReconciliationTask[]
  reviews             SignatureAuthorityReview[]

  // SQL-only: `ux_approval_policy_active` — at most one ACTIVE policy per
  // (organization, workflow key).
  @@unique([organizationId, id], map: "ux_approval_policy_org_id")
  @@unique([organizationId, workflowKey, policyVersion], map: "ux_approval_policy_version")
  @@index([organizationId, workflowKey, status], map: "ix_approval_policy_org_key_status")
  @@map("approval_policy")
}

enum PolicyReconciliationStatus {
  PENDING
  DONE
}

/// The durable work queue behind ORGANIZATION_MOVED (Q-83, docs/23 D-041): one task per policy a
/// move could have stranded. The Kafka handler inserts, a sweeper claims, asks organization-service
/// and suspends. `organizationId` is the tenant of the policy, not the moved organization.
model PolicyReconciliationTask {
  id String @id

  organizationId      String @map("organization_id")
  policyId            String @map("policy_id")
  /// The union that wrote the policy: the scope its hierarchy question is signed for.
  unionId             String @map("union_id")
  /// The move that queued it, and the organization that moved — for the record.
  sourceEventId       String @map("source_event_id")
  movedOrganizationId String @map("moved_organization_id")
  correlationId       String @map("correlation_id")

  status        PolicyReconciliationStatus @default(PENDING)
  attempts      Int                        @default(0)
  /// Bumped when a later move coalesces into this open task: a sweeper that claimed an older
  /// generation must not finish it (its lookup may predate the move).
  generation    Int                        @default(0)
  nextAttemptAt DateTime                   @map("next_attempt_at") @db.Timestamptz(3)
  /// The claim: a time and the token that fences its holder.
  leaseUntil    DateTime?                  @map("lease_until") @db.Timestamptz(3)
  leaseToken    String?                    @map("lease_token")
  /// A closed code (`UPSTREAM_UNAVAILABLE` …), never a message.
  lastErrorCode String?                    @map("last_error_code")

  createdAt    DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @map("updated_at") @db.Timestamptz(3)
  doneAt       DateTime? @map("done_at") @db.Timestamptz(3)
  /// When the move took effect (the event's own instant): what a signature's hierarchy evidence is
  /// compared with. NULL only on a task queued before it existed; `created_at` stands in.
  movedAt      DateTime? @map("moved_at") @db.Timestamptz(3)
  /// The move's hierarchy version: signatures that recorded a LOWER one are flagged. A move that
  /// coalesces into the open task keeps the higher. NULL on a task from before versions.
  movedVersion BigInt? @map("moved_version")
  /// The EARLIEST instant over every move coalesced into the task: the D-050 window is bounded by
  /// it, never by the (later) instant of the move whose version the task keeps.
  earliestMovedAt DateTime @map("earliest_moved_at") @db.Timestamptz(3)

  policy ApprovalPolicy @relation(fields: [organizationId, policyId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  // SQL-only: `ux_policy_reconciliation_open` — at most one PENDING task per policy;
  // `ix_policy_reconciliation_due` — the sweeper's scan.
  @@map("policy_reconciliation_task")
}

/// One authority a policy names. For `contract.signature` each step is a role of the governed
/// organization that may accept a contract for it (alternatives, not a sequence).
model ApprovalPolicyStep {
  id String @id

  organizationId String @map("organization_id")
  policyId       String @map("policy_id")

  policy ApprovalPolicy @relation(fields: [organizationId, policyId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  stepOrder Int @map("step_order")

  /// The authority: an organization and a role within it. Stored as written; for
  /// `contract.signature` the organization is the governed one (checked when written and again,
  /// by the database, when a signature is recorded).
  authorityOrganizationId String @map("authority_organization_id")
  authorityRole           String @map("authority_role")
  authorityLabel          String @map("authority_label")

  @@unique([organizationId, policyId, stepOrder], map: "ux_approval_policy_step_order")
  @@unique([organizationId, policyId, authorityOrganizationId, authorityRole], map: "ux_approval_policy_step_authority")
  @@map("approval_policy_step")
}

/// Idempotent commands (docs/06 § 6.8) — the store asset-service and maintenance-service
/// keep, in this service's own copy (A-02). Keys are the tenant's: `organization_id`
/// leads the primary key.
model IdempotencyKey {
  key            String @map("key")
  organizationId String @map("organization_id")
  endpoint       String

  /// SHA-256 over the canonical request and the caller.
  requestHash String @map("request_hash")
  /// Minted per claim; the command's transaction locks and completes the row by it.
  claimToken  String @map("claim_token")

  responseStatus Int?   @map("response_status")
  responseBody   Json?  @map("response_body")
  /// IN_PROGRESS | COMPLETED (CHECK ck_idempotency_state).
  state          String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// While IN_PROGRESS: the claim's lease, after which a retry may take the key over under a
  /// new token. Once COMPLETED: CONTRACT_IDEMPOTENCY_TTL_HOURS after the response.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([organizationId, endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_key")
}

// ---------------------------------------------------------------------------
// Platform plumbing — identical in shape to every other service's
// ---------------------------------------------------------------------------

model OutboxMessage {
  id String @id

  aggregateType String @map("aggregate_type")
  aggregateId   String @map("aggregate_id")
  eventName     String @map("event_name")
  eventVersion  Int    @default(1) @map("event_version")

  topic        String
  /// `contractId` for every event this service publishes (docs/07 § 7.7).
  partitionKey String @map("partition_key")

  payload Json
  headers Json

  organizationId String? @map("organization_id")
  correlationId  String  @map("correlation_id")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  /// ADR-050 durable claim. `claimToken` is the only fence.
  claimToken     String?   @map("claim_token")
  claimOwner     String?   @map("claim_owner")
  claimExpiresAt DateTime? @map("claim_expires_at") @db.Timestamptz(3)
  claimCount     Int       @default(0) @map("claim_count")
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.Timestamptz(3)

  /// ADR-051 B3: allocated by `EventPublisher.enqueue` inside the caller's
  /// transaction. `isStreamHead` stays false: head maintenance is B4.
  streamSeq    BigInt? @map("stream_seq")
  isStreamHead Boolean @default(false) @map("is_stream_head")

  @@index([publishedAt, createdAt], map: "ix_outbox_pending")
  @@map("outbox_message")
}

/// ADR-051 — one row per ordered stream (`topic + partitionKey`).
model OutboxStreamSequence {
  topic        String
  partitionKey String @map("partition_key")

  nextSeq      BigInt @default(1) @map("next_seq")
  publishedSeq BigInt @default(0) @map("published_seq")

  @@id([topic, partitionKey])
  @@map("outbox_stream_sequence")
}
