// =============================================================================
// identity-service — owned schema
//
// ADR-005: this service owns these tables exclusively. No other service reads
// or writes them; they reach identity over REST or by consuming its events.
//
// Boundary with Keycloak (ADR-008):
//   Keycloak owns authentication  — passwords, sessions, MFA, token issuance.
//   This service owns membership   — who belongs to which organization, in
//                                    which role, and whether that is still
//                                    true today.
// A Keycloak user without a Membership row can authenticate but can act for
// no organization, which is the correct state for someone whose registration
// has not been approved.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Identity
// -----------------------------------------------------------------------------

/// A person. Deliberately NOT tenant-scoped: identity spans organizations.
/// One human administering three dehyaris is one User with three Memberships,
/// not three users — otherwise their audit trail fragments.
model User {
  id String @id

  /// Link to the Keycloak account. Null until the account is provisioned,
  /// which is what lets a registration exist before it is approved.
  keycloakId String? @unique @map("keycloak_id")

  username  String  @unique
  email     String  @unique
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  phone     String?

  status UserStatus @default(PENDING)

  /// Which organization this user's next request acts for by default.
  /// Mirrored to Keycloak as the `org_id` token claim.
  activeOrganizationId String? @map("active_organization_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String    @map("created_by")
  updatedBy String    @map("updated_by")
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")

  memberships          Membership[]
  registrationRequests RegistrationRequest[]

  @@index([status])
  @@index([email])
  @@map("user")
}

enum UserStatus {
  /// Registered, awaiting approval by the platform operator. Cannot act.
  PENDING
  ACTIVE
  SUSPENDED
  /// Terminal. The row is retained because audit history references it.
  DEACTIVATED
}

// -----------------------------------------------------------------------------
// Membership — the tenant boundary
// -----------------------------------------------------------------------------

/// A user's standing in one organization. This is the row that decides which
/// tenants a request may act for, so it is scoped and audited accordingly.
model Membership {
  id String @id

  userId         String @map("user_id")
  organizationId String @map("organization_id")

  status MembershipStatus @default(ACTIVE)

  /// Roles held in *this* organization. A person may be FLEET_MANAGER in one
  /// dehyari and only OPERATOR in another; roles are never global to a user.
  roles String[]

  validFrom  DateTime  @default(now()) @map("valid_from")
  validUntil DateTime? @map("valid_until")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String    @map("created_by")
  updatedBy String    @map("updated_by")
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  /// One live membership per (user, organization). Partial on deletedAt so a
  /// revoked membership does not block the person being re-added later.
  @@unique([userId, organizationId, deletedAt], name: "unique_active_membership")
  @@index([organizationId, status])
  @@index([userId, status])
  @@map("membership")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

// -----------------------------------------------------------------------------
// Roles and permissions — configuration, not code
// -----------------------------------------------------------------------------

/// Platform roles. Seeded from the eleven roles in the product document, but
/// stored rather than hard-coded so a new role is a data change (ADR-023).
model Role {
  name        String     @id
  description String
  scopeLevel  ScopeLevel @map("scope_level")
  /// Roles the platform depends on and which must not be deleted.
  isSystem    Boolean    @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]

  @@map("role")
}

enum ScopeLevel {
  /// Acts across the whole platform.
  PLATFORM
  /// Acts within one organization.
  ORGANIZATION
  /// Acts within one supplier/contractor organization, on its own records.
  SUPPLIER
  /// Read-only, aggregate-only oversight. Never sees row-level data.
  PROVINCE
}

/// A single `resource:action` capability, e.g. `asset:update`.
model Permission {
  id          String  @id
  resource    String
  action      String
  description String

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@map("permission")
}

model RolePermission {
  roleName     String @map("role_name")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleName], references: [name], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleName, permissionId])
  @@map("role_permission")
}

// -----------------------------------------------------------------------------
// Registration
// -----------------------------------------------------------------------------

/// A request to join the platform.
///
/// The product document requires review before activation ("بررسی و تأیید توسط
/// مرکز مدیریت پلتفرم"), so registration is a reviewable record rather than a
/// self-service account creation.
model RegistrationRequest {
  id String @id

  userId String @map("user_id")

  requestedOrganizationId String   @map("requested_organization_id")
  requestedRoles          String[] @map("requested_roles")
  justification           String?

  status RegistrationStatus @default(PENDING)

  reviewedBy       String?   @map("reviewed_by")
  reviewedAt       DateTime? @map("reviewed_at")
  /// Required when rejecting. A refusal without a reason is not reviewable.
  rejectionReason  String?   @map("rejection_reason")

  /// Document ids held by document-service. Never the files themselves.
  documentRefs String[] @map("document_refs")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([requestedOrganizationId, status])
  @@map("registration_request")
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

// -----------------------------------------------------------------------------
// Reference replica
// -----------------------------------------------------------------------------

/// Read-only copy of organization facts, built from ORGANIZATION_* events.
///
/// Exists so this service can render an organization name without a synchronous
/// call to organization-service. Eventually consistent by design.
///
/// CONSTRAINT: never consulted for an authorization decision. Authorization
/// comes from the verified token and from Membership.
model OrganizationRef {
  id     String @id
  name   String
  type   String
  status String

  syncedAt    DateTime @map("synced_at")
  sourceEvent String   @map("source_event")

  @@map("organization_ref")
}

// -----------------------------------------------------------------------------
// Platform plumbing (ADR-021)
// -----------------------------------------------------------------------------

/// Events written in the same transaction as the state change that produced
/// them, then published by the relay.
model OutboxMessage {
  id String @id

  aggregateType String @map("aggregate_type")
  aggregateId   String @map("aggregate_id")
  eventName     String @map("event_name")
  eventVersion  Int    @default(1) @map("event_version")

  topic        String
  partitionKey String @map("partition_key")

  payload Json
  headers Json

  organizationId String? @map("organization_id")
  correlationId  String  @map("correlation_id")

  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  /// Partial index: the relay only ever reads unpublished rows, so the hot
  /// index stays small no matter how much history accumulates.
  @@index([createdAt], map: "idx_outbox_pending")
  @@map("outbox_message")
}

/// Consumer-side idempotency. Inserted before handling; a unique violation
/// means the event was already processed and is skipped.
model ProcessedEvent {
  eventId      String   @map("event_id")
  consumerName String   @map("consumer_name")
  processedAt  DateTime @default(now()) @map("processed_at")

  @@id([eventId, consumerName])
  @@index([processedAt])
  @@map("processed_event")
}

/// Replayed responses for endpoints carrying an Idempotency-Key.
model IdempotencyKey {
  key            String @map("key")
  organizationId String @map("organization_id")
  endpoint       String

  /// SHA-256 of the normalised body. A repeat with a different hash is a
  /// client bug and must be refused, not silently served the old response.
  requestHash String @map("request_hash")

  responseStatus Int?  @map("response_status")
  responseBody   Json? @map("response_body")
  state          String

  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@id([organizationId, endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_key")
}
