{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".env"],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "db:generate": {
      "cache": false,
      "outputs": ["node_modules/.prisma/**", "src/generated/**"]
    },
    // Turbo 2 runs tasks in a strict environment: a variable it is not told
    // about is not passed through. Locally that goes unnoticed because the db
    // scripts load the root .env inside the node process. In CI there is no
    // .env — the connection strings come from the job environment — so without
    // these declarations every migration fails with "DATABASE_URL_<X> is not
    // set" while the same command works on a developer machine (D-005).
    //
    // RASTA_MIGRATION_STATEMENT_TIMEOUT is one run's override of a rewrite
    // migration's statement timeout (D-048), read by scripts/prisma.mjs. The
    // same trap: undeclared, `RASTA_MIGRATION_STATEMENT_TIMEOUT=15min pnpm
    // db:migrate` ran with the migration's 30s default and said nothing.
    // Hashing its value costs nothing — this task is never cached.
    // scripts/prisma-turbo-env.test.mjs holds every task that runs prisma.mjs
    // to every variable it reads.
    "db:migrate": {
      "cache": false,
      "persistent": false,
      "env": ["DATABASE_URL", "DATABASE_URL_*", "RASTA_MIGRATION_STATEMENT_TIMEOUT"]
    },
    // RASTA_ALLOW_DEMO_SEED is the seeds' explicit opt-in (packages/config
    // seed-guard). Undeclared, turbo would withhold it and every seed would
    // refuse even when the operator typed it.
    //
    // Every seed imports @rasta/config (the guard) and its own generated Prisma
    // client, and neither exists in a fresh checkout until built. Without these
    // dependencies a first `pnpm db:seed` failed with "Cannot find module
    // '@rasta/config'", and CI did too wherever a seed ran before the build.
    "db:seed": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "persistent": false,
      "env": ["DATABASE_URL", "DATABASE_URL_*", "RASTA_ALLOW_DEMO_SEED"]
    },
    "typecheck": { "dependsOn": ["^build", "db:generate"], "outputs": [] },
    "lint": { "dependsOn": ["^build"], "outputs": [] },
    // KAFKA_BROKERS is the same trap again (D-005), found by AUD-004 Phase C2:
    // identity-service's `test` runs its integration project too, and its
    // Kafka suite skips itself when the variable is absent. Undeclared, turbo
    // withheld it from the child even with it exported, so `pnpm test` and
    // `pnpm verify` reported green while the Kafka evidence never ran. A run
    // with no broker configured still skips — that is the only case that should.
    //
    // KAFKA_SASL_* and KAFKA_SSL* (RUN-006): the broker authenticates, so a
    // suite reaches it only with its principal's password and the CA. The
    // same trap once more — withheld, a Kafka suite would connect PLAINTEXT
    // and be refused, or skip.
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["coverage/**"],
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_*",
        "DATABASE_POOL_*",
        "DATABASE_STATEMENT_TIMEOUT_MS",
        "REDIS_URL",
        "KAFKA_BROKERS",
        "KAFKA_SASL_*",
        "KAFKA_SSL*",
        "S3_*",
        "DOCUMENT_*",
        "OUTBOX_PURGE_*",
        "OUTBOX_CLAIM_LEASE_SECONDS",
        "ASSET_TRANSFER_CLEARANCE_TIMEOUT_MS",
        "ASSET_TRANSFER_RESOLUTION_TIMEOUT_MS",
        "CONTRACT_ORGANIZATION_REQUEST_TIMEOUT_MS",
        "ECONOMIC_ORGANIZATION_REQUEST_TIMEOUT_MS",
        "MARKETPLACE_ORGANIZATION_REQUEST_TIMEOUT_MS",
        "ORGANIZATION_SERVICE_URL",
        "FLEET_ASSET_SYNC_TRANSACTION_TIMEOUT_MS",
        "INVENTORY_LOCK_TIMEOUT_MS",
        "SECURITY_EVENT_CAPTURE_TIMEOUT_MS",
        "CONSTRUCTION_*",
        "GATEWAY_*",
        "INSURANCE_CLAIM_MAX_DOCUMENTS",
        "INSURANCE_CLAIM_DOCUMENT_STATUSES",
        "MARKETPLACE_RETURN_WINDOW_DAYS",
        "INVENTORY_RETURN_DISPOSITIONS_ALLOWED",
        "INVENTORY_RETURN_RESOLVE_NOTHING_RECEIVED",
        "ANALYTICS_*",
        "CORS_ORIGINS"
      ]
    },
    "test:unit": { "dependsOn": ["^build"], "outputs": ["coverage/**"] },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"],
      // S3_* is here for the same reason DATABASE_URL_* is: document-service's
      // suites talk to a real bucket, and turbo's strict environment means a
      // variable it is not told about simply is not there. Locally the
      // defaults point at the compose MinIO; in CI the credentials differ, and
      // without this the suite would authenticate with the wrong ones and fail
      // as though the bucket were missing (D-005, same trap).
      //
      // DOCUMENT_* is the third instance of it, caught before merge rather than
      // after (ADR-049). Those suites scan against a real ClamAV, and the CI
      // job passes `DOCUMENT_CLAMAV_SOCKET_PATH` and
      // `DOCUMENT_SCAN_SIGNATURE_MAX_AGE_HOURS` in the step environment.
      // Undeclared, turbo drops both: the service then loads its configuration
      // with no scanner address at all and every document suite fails at
      // startup — on a developer machine the same command passes, because the
      // shell exported them directly.
      //
      // OUTBOX_PURGE_* (D-052): the integration suites build the AppModule
      // from process.env, purge scheduler included; see "dev" below. The
      // DATABASE_* settings for the same reason (databaseEnvSchema, #268),
      // and the settings an operation budget is computed from, and
      // construction's and the gateway's (also "dev" below).
      //
      // CONSTRUCTION_* (Codex r1 on #271): the same for construction-service's
      // own settings; see "dev" below.
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_*",
        "DATABASE_POOL_*",
        "DATABASE_STATEMENT_TIMEOUT_MS",
        "REDIS_URL",
        "KAFKA_BROKERS",
        "KAFKA_SASL_*",
        "KAFKA_SSL*",
        "S3_*",
        "DOCUMENT_*",
        "OUTBOX_PURGE_*",
        "OUTBOX_CLAIM_LEASE_SECONDS",
        "ASSET_TRANSFER_CLEARANCE_TIMEOUT_MS",
        "ASSET_TRANSFER_RESOLUTION_TIMEOUT_MS",
        "CONTRACT_ORGANIZATION_REQUEST_TIMEOUT_MS",
        "ECONOMIC_ORGANIZATION_REQUEST_TIMEOUT_MS",
        "MARKETPLACE_ORGANIZATION_REQUEST_TIMEOUT_MS",
        "ORGANIZATION_SERVICE_URL",
        "FLEET_ASSET_SYNC_TRANSACTION_TIMEOUT_MS",
        "INVENTORY_LOCK_TIMEOUT_MS",
        "SECURITY_EVENT_CAPTURE_TIMEOUT_MS",
        "CONSTRUCTION_*",
        "GATEWAY_*",
        "INSURANCE_CLAIM_MAX_DOCUMENTS",
        "INSURANCE_CLAIM_DOCUMENT_STATUSES",
        "MARKETPLACE_RETURN_WINDOW_DAYS",
        "INVENTORY_RETURN_DISPOSITIONS_ALLOWED",
        "INVENTORY_RETURN_RESOLVE_NOTHING_RECEIVED",
        "ANALYTICS_*",
        "CORS_ORIGINS"
      ]
    },
    // identity-service's two 500-write aggregation proofs, run alone after the
    // parallel workspace phase by `scripts/run-test-phases.mjs` (docs/14
    // § 14.3). Never cached: its evidence is a run against the live database,
    // and a replayed green would be no evidence at all. The same strict
    // environment applies — undeclared, DATABASE_URL_IDENTITY never arrives.
    "test:aggregation-stress": {
      "cache": false,
      "dependsOn": ["^build", "db:generate"],
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_*",
        "DATABASE_POOL_*",
        "DATABASE_STATEMENT_TIMEOUT_MS",
        "OUTBOX_CLAIM_LEASE_SECONDS",
        "SECURITY_EVENT_CAPTURE_TIMEOUT_MS",
        "REDIS_URL",
        "KAFKA_BROKERS",
        "KAFKA_SASL_*",
        "KAFKA_SSL*"
      ]
    },
    // Turbo runs tasks in a strict environment, so anything the E2E harness
    // reads has to be declared here or it simply is not there — and the
    // failure looks like "the gateway is down" rather than "the port was
    // never passed through", which is the same trap D-005 sprang on
    // `db:migrate`.
    "test:e2e": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": [
        "E2E_*",
        "KEYCLOAK_*",
        "KAFKA_BROKERS",
        "KAFKA_SASL_*",
        "KAFKA_SSL*",
        "INTERNAL_TOKEN_SECRET",
        "PORT_API_GATEWAY",
        "PORT_ECONOMIC",
        "PORT_MARKETPLACE",
        "PORT_DOCUMENT",
        "PLAYWRIGHT_*",
        // The refusal scenario aligns its burst to identity-service's
        // aggregation window, so it must read the value the service runs with.
        "SECURITY_EVENT_AGGREGATION_WINDOW_SECONDS"
      ]
    },
    // OUTBOX_PURGE_* (D-052, Codex r1 on #247): the D-005 trap once more, in
    // the task that starts the services. A service reads the root .env itself
    // (`node --env-file`, where the shell's value wins), so undeclared,
    // `OUTBOX_PURGE_ENABLED=false pnpm dev` ran with the purge on, and an
    // invalid value in the shell never reached the validation that refuses
    // it. scripts/outbox-purge-turbo-env.test.mjs holds every task that starts
    // a service wiring the purge to every variable of outboxPurgeEnvSchema.
    //
    // DATABASE_POOL_*, DATABASE_STATEMENT_TIMEOUT_MS and DATABASE_URL_* (Codex
    // r1 on #268): the same trap for databaseEnvSchema, here and in the test
    // tasks above — undeclared, `DATABASE_POOL_SIZE=2 pnpm dev` ran on Prisma's
    // default pool and a malformed value never met the check that refuses it.
    // Each service reads its own DATABASE_URL_<SVC>. A bare DATABASE_URL is
    // deliberately not passed here: every service prefers it, so one exported
    // in the shell would point all of them at a single database.
    // scripts/database-turbo-env.test.mjs holds these tasks to the schema.
    //
    // The settings an operation budget is computed from (Codex r4 on #268):
    // loadEnv refuses a DATABASE_STATEMENT_TIMEOUT_MS at or below the largest
    // budget, so `FLEET_ASSET_SYNC_TRANSACTION_TIMEOUT_MS=20000 pnpm dev` must
    // reach the check and the service together, not lose to `.env`. And
    // CONSTRUCTION_* and GATEWAY_*: the tender caps and opening deadlines
    // (#250) came in undeclared — exporting a standing-bid cap of 1 still
    // allowed a second bidder. The same test derives both lists, from every
    // service's operation-budgets.ts and from the two configurations. Every
    // other service's own settings are still withheld here (a follow-up).
    //
    // CONSTRUCTION_* (Codex r1 on #271): construction-service's own settings,
    // the trap again — `CONSTRUCTION_TRANSACTION_TIMEOUT_MS=60000 pnpm dev` ran
    // on the .env value. scripts/construction-turbo-env.test.mjs holds every
    // task that starts the service to every CONSTRUCTION_* key of its schema.
    //
    // INSURANCE_CLAIM_MAX_DOCUMENTS and INSURANCE_CLAIM_DOCUMENT_STATUSES
    // (Codex r2 on #304): asset-service's claim-document policy (Q-128), the
    // trap once more — `INSURANCE_CLAIM_MAX_DOCUMENTS=1 pnpm dev` accepted a
    // second document on the .env limit of 20, and `=0` never met the boot
    // refusal. Declared here and in the test tasks above. From this one on,
    // scripts/service-env-turbo.test.mjs holds every task that starts a
    // service to every key of that service's own schema: a new setting is
    // declared or the check fails. The settings withheld before it are listed
    // in scripts/service-env-turbo-withheld.json, a list that may only shrink.
    //
    // MARKETPLACE_RETURN_WINDOW_DAYS (RUN-005, Q-132): marketplace's return
    // window, no default — unset, every return request is refused. The first
    // new setting under that check, declared here and in the test tasks above.
    // INVENTORY_RETURN_DISPOSITIONS_ALLOWED (RUN-005 PR 2b, Q-133) likewise:
    // the dispositions a return may resolve to, empty by default — unset, no
    // return can be resolved. INVENTORY_RETURN_RESOLVE_NOTHING_RECEIVED (Q-133 (4))
    // likewise: false by default — unset, a return of which nothing arrived is
    // not resolved.
    //
    // ANALYTICS_* (RUN-001, ADR-071): analytics-service's own settings — the
    // fleet dashboard's readers and the projection switch — declared from its
    // first commit. CORS_ORIGINS with them: every service's schema reads it, and
    // declaring it for analytics declares it for all, so it leaves the withheld
    // list in the three tasks above (identity's aggregation-stress task still
    // withholds it).
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "OUTBOX_PURGE_*",
        "DATABASE_URL_*",
        "DATABASE_POOL_*",
        "DATABASE_STATEMENT_TIMEOUT_MS",
        "OUTBOX_CLAIM_LEASE_SECONDS",
        "ASSET_TRANSFER_CLEARANCE_TIMEOUT_MS",
        "ASSET_TRANSFER_RESOLUTION_TIMEOUT_MS",
        "CONTRACT_ORGANIZATION_REQUEST_TIMEOUT_MS",
        "ECONOMIC_ORGANIZATION_REQUEST_TIMEOUT_MS",
        "MARKETPLACE_ORGANIZATION_REQUEST_TIMEOUT_MS",
        "ORGANIZATION_SERVICE_URL",
        "FLEET_ASSET_SYNC_TRANSACTION_TIMEOUT_MS",
        "INVENTORY_LOCK_TIMEOUT_MS",
        "SECURITY_EVENT_CAPTURE_TIMEOUT_MS",
        "CONSTRUCTION_*",
        "GATEWAY_*",
        "INSURANCE_CLAIM_MAX_DOCUMENTS",
        "INSURANCE_CLAIM_DOCUMENT_STATUSES",
        "MARKETPLACE_RETURN_WINDOW_DAYS",
        "INVENTORY_RETURN_DISPOSITIONS_ALLOWED",
        "INVENTORY_RETURN_RESOLVE_NOTHING_RECEIVED",
        "ANALYTICS_*",
        "CORS_ORIGINS"
      ]
    },
    "clean": { "cache": false }
  }
}
